{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/requirements/erp/acceptance-criteria.schema.json",
  "title": "ERP atomic acceptance criterion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "requirement",
    "source",
    "criterion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9-]+\\.(?:AC|CTX)-[0-9]{2}$"
    },
    "requirement": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9-]+$"
    },
    "source": {
      "enum": [
        "01-actors-and-auth.md",
        "02-domain-model.md",
        "03-functional-requirements.md",
        "04-business-rules.md",
        "05-non-functional.md"
      ]
    },
    "criterion": {
      "type": "string",
      "minLength": 1
    }
  }
}
