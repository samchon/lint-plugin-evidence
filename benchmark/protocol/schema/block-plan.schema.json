{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/block-plan.schema.json",
  "title": "Authorized benchmark concurrency block plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "blockId",
    "protocolRevision",
    "sourceMergedCommit",
    "priceSheetSha256",
    "randomizationSeed",
    "cells",
    "authorization"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "blockId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$"
    },
    "protocolRevision": {
      "type": "string",
      "minLength": 1
    },
    "sourceMergedCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "priceSheetSha256": {
      "$ref": "#/$defs/sha256"
    },
    "randomizationSeed": {
      "type": "string",
      "minLength": 16
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runId",
          "subject",
          "arm",
          "replicate",
          "launchOrder",
          "predicted",
          "limits"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$"
          },
          "subject": {
            "enum": [
              "todo",
              "reddit",
              "shopping",
              "erp"
            ]
          },
          "arm": {
            "enum": [
              "plain",
              "evidence"
            ]
          },
          "replicate": {
            "type": "integer",
            "minimum": 1
          },
          "launchOrder": {
            "type": "integer",
            "minimum": 1
          },
          "predicted": {
            "$ref": "#/$defs/cost"
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "providerCredits",
              "wallClockHours"
            ],
            "properties": {
              "providerCredits": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "wallClockHours": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizedBy",
        "authorizedAtUtc",
        "quotaState",
        "statement"
      ],
      "properties": {
        "authorizedBy": {
          "type": "string",
          "minLength": 1
        },
        "authorizedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "quotaState": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p50WallClockHours",
        "p90WallClockHours",
        "p50ProviderTokens",
        "p90ProviderTokens",
        "p50ProviderCredits",
        "p90ProviderCredits"
      ],
      "properties": {
        "p50WallClockHours": {
          "type": "number",
          "minimum": 0
        },
        "p90WallClockHours": {
          "type": "number",
          "minimum": 0
        },
        "p50ProviderTokens": {
          "type": "number",
          "minimum": 0
        },
        "p90ProviderTokens": {
          "type": "number",
          "minimum": 0
        },
        "p50ProviderCredits": {
          "type": "number",
          "minimum": 0
        },
        "p90ProviderCredits": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
