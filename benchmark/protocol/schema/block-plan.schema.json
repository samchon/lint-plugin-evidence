{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/block-plan.schema.json",
  "title": "Authorized benchmark concurrency block plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "blockId",
    "repository",
    "preparedAtUtc",
    "replicate",
    "subjects",
    "protocolRevision",
    "protocolRevisionSha256",
    "sourceMergedCommit",
    "priceSheetSha256",
    "subjectFreezeManifestSha256",
    "randomizationSeed",
    "sourceAdmission",
    "productProvenance",
    "concurrency",
    "launchOrder",
    "cells",
    "authorization"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "blockId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remoteUrl",
        "relativeRoot"
      ],
      "properties": {
        "remoteUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/samchon/lint-plugin-evidence(?:\\.git)?$"
        },
        "relativeRoot": {
          "const": "."
        }
      }
    },
    "preparedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "replicate": {
      "type": "integer",
      "minimum": 1
    },
    "subjects": {
      "oneOf": [
        {
          "const": [
            "todo",
            "reddit"
          ]
        },
        {
          "const": [
            "shopping",
            "erp"
          ]
        }
      ]
    },
    "protocolRevision": {
      "type": "string",
      "minLength": 1
    },
    "protocolRevisionSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sourceMergedCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "priceSheetSha256": {
      "$ref": "#/$defs/sha256"
    },
    "subjectFreezeManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "randomizationSeed": {
      "type": "string",
      "minLength": 16
    },
    "sourceAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mergedBaseRef",
        "mergedBaseRevision",
        "remoteVerifiedAtUtc",
        "sealedSource",
        "sealedSourceManifest"
      ],
      "properties": {
        "mergedBaseRef": {
          "type": "string",
          "minLength": 1
        },
        "mergedBaseRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "remoteVerifiedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "sealedSource": {
          "$ref": "#/$defs/pathDigest"
        },
        "sealedSourceManifest": {
          "$ref": "#/$defs/pathDigest"
        }
      }
    },
    "productProvenance": {
      "$ref": "#/$defs/pathDigest"
    },
    "concurrency": {
      "const": 4
    },
    "launchOrder": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$"
      }
    },
    "cells": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runId",
          "subject",
          "arm",
          "replicate",
          "launchOrder",
          "prepared",
          "predicted",
          "limits"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$"
          },
          "subject": {
            "enum": [
              "todo",
              "reddit",
              "shopping",
              "erp"
            ]
          },
          "arm": {
            "enum": [
              "plain",
              "evidence"
            ]
          },
          "replicate": {
            "type": "integer",
            "minimum": 1
          },
          "launchOrder": {
            "type": "integer",
            "minimum": 1
          },
          "prepared": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "workspace",
              "materializationManifest",
              "setupRecord"
            ],
            "properties": {
              "root": {
                "$ref": "#/$defs/repositoryRelativePath"
              },
              "workspace": {
                "$ref": "#/$defs/repositoryRelativePath"
              },
              "materializationManifest": {
                "$ref": "#/$defs/pathDigest"
              },
              "setupRecord": {
                "$ref": "#/$defs/pathDigest"
              }
            }
          },
          "predicted": {
            "$ref": "#/$defs/cost"
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "maximumObservedTotalTokens",
              "hardWallDurationSeconds",
              "hardCeilingGuaranteed"
            ],
            "properties": {
              "maximumObservedTotalTokens": {
                "type": "integer",
                "minimum": 1
              },
              "hardWallDurationSeconds": {
                "type": "integer",
                "minimum": 1
              },
              "hardCeilingGuaranteed": {
                "const": false
              }
            }
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizedBy",
        "authorizedAtUtc",
        "quotaState",
        "statement",
        "maximumObservedBlockTotalTokens",
        "blockHardWallDurationSeconds",
        "hardCeilingGuaranteed",
        "monetaryStatus"
      ],
      "properties": {
        "authorizedBy": {
          "type": "string",
          "minLength": 1
        },
        "authorizedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "quotaState": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "bucketId",
            "usedPercent",
            "windowMinutes",
            "resetsAtUtc",
            "reached",
            "spendControlReached",
            "reservePolicy",
            "capturedAtUtc",
            "snapshotSha256",
            "rawPayloadPersisted",
            "guardRelation"
          ],
          "properties": {
            "source": {
              "const": "account/rateLimits/read"
            },
            "bucketId": {
              "type": "string",
              "minLength": 1
            },
            "usedPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "windowMinutes": {
              "type": "integer",
              "minimum": 1
            },
            "resetsAtUtc": {
              "type": "string",
              "format": "date-time"
            },
            "reached": {
              "type": "boolean"
            },
            "spendControlReached": {
              "type": "boolean"
            },
            "reservePolicy": {
              "type": "string",
              "minLength": 1
            },
            "capturedAtUtc": {
              "type": "string",
              "format": "date-time"
            },
            "snapshotSha256": {
              "$ref": "#/$defs/sha256"
            },
            "rawPayloadPersisted": {
              "const": false
            },
            "guardRelation": {
              "const": "independent-first-hit-or"
            }
          }
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "maximumObservedBlockTotalTokens": {
          "type": "integer",
          "minimum": 1
        },
        "blockHardWallDurationSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "hardCeilingGuaranteed": {
          "const": false
        },
        "monetaryStatus": {
          "const": "unavailable"
        }
      }
    }
  },
  "$defs": {
    "repositoryRelativePath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "pathDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p50WallClockHours",
        "p90WallClockHours",
        "p50ProviderTokens",
        "p90ProviderTokens",
        "p50ProviderCredits",
        "p90ProviderCredits",
        "monetaryStatus"
      ],
      "properties": {
        "p50WallClockHours": {
          "type": "number",
          "minimum": 0
        },
        "p90WallClockHours": {
          "type": "number",
          "minimum": 0
        },
        "p50ProviderTokens": {
          "type": "number",
          "minimum": 0
        },
        "p90ProviderTokens": {
          "type": "number",
          "minimum": 0
        },
        "p50ProviderCredits": {
          "const": null
        },
        "p90ProviderCredits": {
          "const": null
        },
        "monetaryStatus": {
          "const": "unavailable"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
