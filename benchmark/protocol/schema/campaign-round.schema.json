{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/campaign-round.schema.json",
  "title": "Completed Phase 2 campaign round",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "index",
    "startedAtUtc",
    "completedAtUtc",
    "phase1Boundary",
    "startDigest",
    "bundle",
    "finders",
    "rawCandidateCount",
    "findingLifecycles",
    "reconciliation",
    "mutationCheck",
    "verifiedNewCount",
    "fixManifest",
    "fixResult",
    "fixResolution",
    "gates",
    "endDigest",
    "sameDigestAsStart",
    "sameDigestAsPreviousCleanRound",
    "valid",
    "invalidReasons",
    "clean",
    "consecutiveCleanRounds",
    "establishesTDry"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$"
    },
    "index": {
      "type": "integer",
      "minimum": 1
    },
    "startedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "completedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "phase1Boundary": {
      "$ref": "#/$defs/phase1Boundary"
    },
    "startDigest": {
      "$ref": "#/$defs/sha256"
    },
    "bundle": {
      "$ref": "#/$defs/bundle"
    },
    "finders": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/finder1"
        },
        {
          "$ref": "#/$defs/finder2"
        },
        {
          "$ref": "#/$defs/finder3"
        },
        {
          "$ref": "#/$defs/finder4"
        }
      ],
      "items": false
    },
    "rawCandidateCount": {
      "type": "integer",
      "minimum": 0
    },
    "findingLifecycles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/findingLifecycle"
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycleCount",
        "deduplicatedNewCount",
        "verifiedByFinderCount",
        "mutationVerifiedCount",
        "fixHandoffCount",
        "countsReconciled",
        "verifiedSetMatchesHandoff"
      ],
      "properties": {
        "lifecycleCount": {
          "type": "integer",
          "minimum": 0
        },
        "deduplicatedNewCount": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedByFinderCount": {
          "type": "integer",
          "minimum": 0
        },
        "mutationVerifiedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "fixHandoffCount": {
          "type": "integer",
          "minimum": 0
        },
        "countsReconciled": {
          "const": true
        },
        "verifiedSetMatchesHandoff": {
          "const": true
        }
      }
    },
    "mutationCheck": {
      "$ref": "#/$defs/mutation"
    },
    "verifiedNewCount": {
      "type": "integer",
      "minimum": 0
    },
    "fixManifest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "fixer-handoff.schema.json"
        }
      ]
    },
    "fixResult": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "threadId",
            "round",
            "manifestSha256",
            "responseIds",
            "completed",
            "changedPaths"
          ],
          "properties": {
            "threadId": {
              "type": "string",
              "minLength": 1
            },
            "round": {
              "type": "integer",
              "minimum": 1
            },
            "manifestSha256": {
              "$ref": "#/$defs/sha256"
            },
            "responseIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "completed": {
              "type": "boolean"
            },
            "changedPaths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "fixResolution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/fixResolution"
        }
      ]
    },
    "gates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "endDigest": {
      "$ref": "#/$defs/sha256"
    },
    "sameDigestAsStart": {
      "type": "boolean"
    },
    "sameDigestAsPreviousCleanRound": {
      "type": "boolean"
    },
    "valid": {
      "type": "boolean"
    },
    "invalidReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clean": {
      "type": "boolean"
    },
    "consecutiveCleanRounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "establishesTDry": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verifiedNewCount": {
            "const": 0
          }
        },
        "required": [
          "verifiedNewCount"
        ]
      },
      "then": {
        "properties": {
          "fixManifest": {
            "type": "null"
          },
          "fixResult": {
            "type": "null"
          },
          "fixResolution": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "fixManifest": {
            "type": "object"
          },
          "fixResult": {
            "type": "object"
          },
          "fixResolution": {
            "type": "object"
          },
          "clean": {
            "const": false
          },
          "consecutiveCleanRounds": {
            "const": 0
          },
          "establishesTDry": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "valid": {
            "const": false
          }
        },
        "required": [
          "valid"
        ]
      },
      "then": {
        "properties": {
          "invalidReasons": {
            "minItems": 1
          },
          "clean": {
            "const": false
          },
          "consecutiveCleanRounds": {
            "const": 0
          },
          "establishesTDry": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "invalidReasons": {
            "const": []
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "clean": {
            "const": true
          }
        },
        "required": [
          "clean"
        ]
      },
      "then": {
        "properties": {
          "valid": {
            "const": true
          },
          "verifiedNewCount": {
            "const": 0
          },
          "sameDigestAsStart": {
            "const": true
          },
          "mutationCheck": {
            "properties": {
              "outcome": {
                "const": "expected_failure"
              },
              "restoredBytesExact": {
                "const": true
              },
              "unauthorizedMutationPaths": {
                "const": []
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "establishesTDry": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "establishesTDry": {
            "const": true
          }
        },
        "required": [
          "establishesTDry"
        ]
      },
      "then": {
        "properties": {
          "clean": {
            "const": true
          },
          "consecutiveCleanRounds": {
            "const": 2
          },
          "sameDigestAsPreviousCleanRound": {
            "const": true
          }
        }
      }
    }
  ],
  "$defs": {
    "phase1Boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tDoneEventSeq",
        "tDoneEventSha256",
        "tDoneSnapshotSha256",
        "completionChallengeTurnId",
        "completionChallengeResponseId",
        "completionChallengeAdjudicationSha256",
        "completionChallengeCompletedAtUtc",
        "completionChallengeCompleted"
      ],
      "properties": {
        "tDoneEventSeq": {
          "type": "integer",
          "minimum": 1
        },
        "tDoneEventSha256": {
          "$ref": "#/$defs/sha256"
        },
        "tDoneSnapshotSha256": {
          "$ref": "#/$defs/sha256"
        },
        "completionChallengeTurnId": {
          "type": "string",
          "minLength": 1
        },
        "completionChallengeResponseId": {
          "type": "string",
          "minLength": 1
        },
        "completionChallengeAdjudicationSha256": {
          "$ref": "#/$defs/sha256"
        },
        "completionChallengeCompletedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "completionChallengeCompleted": {
          "const": true
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "sourceAuthoredDigest",
        "bundleId",
        "manifestSha256",
        "canonicalBundleSha256",
        "instances"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "sourceAuthoredDigest": {
          "$ref": "#/$defs/sha256"
        },
        "bundleId": {
          "type": "string",
          "minLength": 1
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalBundleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "instances": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "$ref": "#/$defs/instance1"
            },
            {
              "$ref": "#/$defs/instance2"
            },
            {
              "$ref": "#/$defs/instance3"
            },
            {
              "$ref": "#/$defs/instance4"
            }
          ],
          "items": false
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignmentId",
        "instanceId",
        "bundleSha256",
        "readOnly",
        "priorTranscriptAbsent",
        "armInformationAbsent"
      ],
      "properties": {
        "assignmentId": {
          "type": "string"
        },
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "bundleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "readOnly": {
          "const": true
        },
        "priorTranscriptAbsent": {
          "const": true
        },
        "armInformationAbsent": {
          "const": true
        }
      }
    },
    "instance1": {
      "allOf": [
        {
          "$ref": "#/$defs/instance"
        },
        {
          "properties": {
            "assignmentId": {
              "const": "F1-requirements-database"
            }
          }
        }
      ]
    },
    "instance2": {
      "allOf": [
        {
          "$ref": "#/$defs/instance"
        },
        {
          "properties": {
            "assignmentId": {
              "const": "F2-api-logic"
            }
          }
        }
      ]
    },
    "instance3": {
      "allOf": [
        {
          "$ref": "#/$defs/instance"
        },
        {
          "properties": {
            "assignmentId": {
              "const": "F3-tests"
            }
          }
        }
      ]
    },
    "instance4": {
      "allOf": [
        {
          "$ref": "#/$defs/instance"
        },
        {
          "properties": {
            "assignmentId": {
              "const": "F4-frontend"
            }
          }
        }
      ]
    },
    "finder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "assignmentId",
        "lenses",
        "threadId",
        "bundleInstanceId",
        "bundleSha256",
        "priorTranscriptAbsent",
        "armInformationAbsent",
        "findings",
        "responseIds"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "assignmentId": {
          "type": "string"
        },
        "lenses": {
          "type": "array",
          "items": {
            "enum": [
              "requirements",
              "database",
              "api",
              "logic",
              "tests",
              "frontend"
            ]
          }
        },
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "bundleInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "bundleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "priorTranscriptAbsent": {
          "const": true
        },
        "armInformationAbsent": {
          "const": true
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "responseIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "fingerprint",
        "lens",
        "clauseIds",
        "behavior",
        "expectedBehavior",
        "observedBehavior",
        "locations",
        "reproduction",
        "claim",
        "evidence"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "lens": {
          "enum": [
            "requirements",
            "database",
            "api",
            "logic",
            "tests",
            "frontend"
          ]
        },
        "clauseIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "behavior": {
          "type": "string",
          "minLength": 1
        },
        "expectedBehavior": {
          "type": "string",
          "minLength": 1
        },
        "observedBehavior": {
          "type": "string",
          "minLength": 1
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reproduction": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "finder1": {
      "allOf": [
        {
          "$ref": "#/$defs/finder"
        },
        {
          "properties": {
            "assignmentId": {
              "const": "F1-requirements-database"
            },
            "lenses": {
              "const": [
                "requirements",
                "database"
              ]
            }
          }
        }
      ]
    },
    "finder2": {
      "allOf": [
        {
          "$ref": "#/$defs/finder"
        },
        {
          "properties": {
            "assignmentId": {
              "const": "F2-api-logic"
            },
            "lenses": {
              "const": [
                "api",
                "logic"
              ]
            }
          }
        }
      ]
    },
    "finder3": {
      "allOf": [
        {
          "$ref": "#/$defs/finder"
        },
        {
          "properties": {
            "assignmentId": {
              "const": "F3-tests"
            },
            "lenses": {
              "const": [
                "tests"
              ]
            }
          }
        }
      ]
    },
    "finder4": {
      "allOf": [
        {
          "$ref": "#/$defs/finder"
        },
        {
          "properties": {
            "assignmentId": {
              "const": "F4-frontend"
            },
            "lenses": {
              "const": [
                "frontend"
              ]
            }
          }
        }
      ]
    },
    "findingLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "fingerprint",
        "finderAssignmentId",
        "dedupeDecision",
        "verification",
        "disposition",
        "canonicalFindingId"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "finderAssignmentId": {
          "enum": [
            "F1-requirements-database",
            "F2-api-logic",
            "F3-tests",
            "F4-frontend"
          ]
        },
        "dedupeDecision": {
          "$ref": "#/$defs/dedupe"
        },
        "verification": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/verification"
            }
          ]
        },
        "disposition": {
          "enum": [
            "duplicate",
            "rejected",
            "unverifiable",
            "repair_pending"
          ]
        },
        "canonicalFindingId": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dedupeDecision": {
                "type": "object",
                "properties": {
                  "decision": {
                    "const": "duplicate"
                  }
                }
              }
            },
            "required": [
              "dedupeDecision"
            ]
          },
          "then": {
            "properties": {
              "verification": {
                "type": "null"
              },
              "disposition": {
                "const": "duplicate"
              }
            }
          },
          "else": {
            "properties": {
              "verification": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification": {
                "type": "object",
                "properties": {
                  "verdict": {
                    "const": "verified"
                  }
                },
                "required": [
                  "verdict"
                ]
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "properties": {
              "disposition": {
                "const": "repair_pending"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification": {
                "type": "object",
                "properties": {
                  "verdict": {
                    "const": "rejected"
                  }
                },
                "required": [
                  "verdict"
                ]
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "properties": {
              "disposition": {
                "const": "rejected"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification": {
                "type": "object",
                "properties": {
                  "verdict": {
                    "const": "duplicate"
                  }
                },
                "required": [
                  "verdict"
                ]
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "properties": {
              "disposition": {
                "const": "duplicate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification": {
                "type": "object",
                "properties": {
                  "verdict": {
                    "const": "unverifiable"
                  }
                },
                "required": [
                  "verdict"
                ]
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "properties": {
              "disposition": {
                "const": "unverifiable"
              }
            }
          }
        }
      ]
    },
    "dedupe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "fingerprint",
        "clauseIds",
        "behavior",
        "locations",
        "reproduction",
        "decision",
        "canonicalFindingId",
        "duplicateOf",
        "basis"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "clauseIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "behavior": {
          "type": "string",
          "minLength": 1
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reproduction": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "new",
            "duplicate"
          ]
        },
        "canonicalFindingId": {
          "type": "string",
          "minLength": 1
        },
        "duplicateOf": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "duplicate"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "duplicateOf": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "duplicateOf": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "fingerprint",
        "canonicalFindingId",
        "threadId",
        "bundleSha256",
        "priorTranscriptAbsent",
        "armInformationAbsent",
        "verdict",
        "classification",
        "severity",
        "rationale",
        "responseIds"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalFindingId": {
          "type": "string",
          "minLength": 1
        },
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "bundleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "priorTranscriptAbsent": {
          "const": true
        },
        "armInformationAbsent": {
          "const": true
        },
        "verdict": {
          "enum": [
            "verified",
            "rejected",
            "duplicate",
            "unverifiable"
          ]
        },
        "classification": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "requirement_omission",
                "partial_implementation",
                "semantic_defect",
                "false_acknowledgement",
                "configuration_coverage",
                "test_oracle_gap",
                "non_defect"
              ]
            }
          ]
        },
        "severity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            }
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "responseIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "round",
        "authoredStateDigest",
        "selection",
        "targetPath",
        "targetSpan",
        "preSha256",
        "mutatedSha256",
        "command",
        "expectedFailure",
        "actualExitCode",
        "actualDiagnosticSha256",
        "outcome",
        "verifiedFinding",
        "restoreSha256",
        "restoredBytesExact",
        "unauthorizedMutationPaths",
        "checkedAtUtc"
      ],
      "properties": {
        "owner": {
          "const": "harness"
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "authoredStateDigest": {
          "$ref": "#/$defs/sha256"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "populationSha256",
            "selectionSha256",
            "targetId",
            "criterionId"
          ],
          "properties": {
            "populationSha256": {
              "$ref": "#/$defs/sha256"
            },
            "selectionSha256": {
              "$ref": "#/$defs/sha256"
            },
            "targetId": {
              "type": "string",
              "minLength": 1
            },
            "criterionId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "targetPath": {
          "type": "string",
          "minLength": 1
        },
        "targetSpan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "preSha256": {
          "$ref": "#/$defs/sha256"
        },
        "mutatedSha256": {
          "$ref": "#/$defs/sha256"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "expectedFailure": {
          "type": "string",
          "minLength": 1
        },
        "actualExitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "actualDiagnosticSha256": {
          "$ref": "#/$defs/sha256"
        },
        "outcome": {
          "enum": [
            "expected_failure",
            "verified_test_oracle_gap"
          ]
        },
        "verifiedFinding": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "verified-finding.schema.json"
            }
          ]
        },
        "restoreSha256": {
          "$ref": "#/$defs/sha256"
        },
        "restoredBytesExact": {
          "type": "boolean"
        },
        "unauthorizedMutationPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checkedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "verified_test_oracle_gap"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "verifiedFinding": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "verifiedFinding": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "fixResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "manifestSha256",
        "beforeDigest",
        "afterFixDigest",
        "authoredDigestChanged",
        "freshBundleSha256",
        "findings",
        "verifiedSetMatchesResolution",
        "allResolved"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "beforeDigest": {
          "$ref": "#/$defs/sha256"
        },
        "afterFixDigest": {
          "$ref": "#/$defs/sha256"
        },
        "authoredDigestChanged": {
          "const": true
        },
        "freshBundleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canonicalFindingId",
              "source",
              "verdict",
              "freshVerifierThreadId",
              "responseIds",
              "reproduction",
              "mutationReplay"
            ],
            "properties": {
              "canonicalFindingId": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "enum": [
                  "finder_verification",
                  "harness_mutation"
                ]
              },
              "verdict": {
                "const": "fixed"
              },
              "freshVerifierThreadId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "responseIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reproduction": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "command",
                  "exitCode",
                  "evidenceSha256",
                  "expectedResolution",
                  "matched"
                ],
                "properties": {
                  "command": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "exitCode": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "evidenceSha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "expectedResolution": {
                    "type": "string",
                    "minLength": 1
                  },
                  "matched": {
                    "const": true
                  }
                }
              },
              "mutationReplay": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sameTargetId",
                      "expectedFailureMatched",
                      "restoreSha256",
                      "restoredBytesExact"
                    ],
                    "properties": {
                      "sameTargetId": {
                        "const": true
                      },
                      "expectedFailureMatched": {
                        "const": true
                      },
                      "restoreSha256": {
                        "$ref": "#/$defs/sha256"
                      },
                      "restoredBytesExact": {
                        "const": true
                      }
                    }
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "source": {
                      "const": "finder_verification"
                    }
                  },
                  "required": [
                    "source"
                  ]
                },
                "then": {
                  "properties": {
                    "freshVerifierThreadId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mutationReplay": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "freshVerifierThreadId": {
                      "type": "null"
                    },
                    "mutationReplay": {
                      "type": "object"
                    }
                  }
                }
              }
            ]
          }
        },
        "verifiedSetMatchesResolution": {
          "const": true
        },
        "allResolved": {
          "const": true
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "startedAtUtc",
        "completedAtUtc",
        "exitCode",
        "signal",
        "timedOut",
        "durationMs",
        "stdoutPath",
        "stderrPath"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "build",
            "test",
            "custom"
          ]
        },
        "startedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "completedAtUtc": {
          "type": "string",
          "format": "date-time"
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "type": [
            "string",
            "null"
          ]
        },
        "timedOut": {
          "type": "boolean"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "stdoutPath": {
          "type": "string",
          "minLength": 1
        },
        "stderrPath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
