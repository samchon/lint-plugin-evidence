{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/result-promotion.schema.json",
  "title": "Final core-plus-postprocess benchmark result promotion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "subject",
    "arm",
    "runId",
    "sourceRunRoot",
    "sourceManifestSha256",
    "coreSeal",
    "postprocess",
    "retainedRun",
    "latestPointer",
    "demoWorkspace",
    "gitRoundTrip",
    "priorRunSet",
    "concurrencyControl",
    "promotedAtUtc",
    "manifestSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "subject": {
      "enum": [
        "todo",
        "reddit",
        "shopping",
        "erp"
      ]
    },
    "arm": {
      "enum": [
        "plain",
        "evidence"
      ]
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$"
    },
    "sourceRunRoot": {
      "type": "string",
      "minLength": 1
    },
    "sourceManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "coreSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminalStatus",
        "coreTreeSha256",
        "coreSealSha256",
        "tDoneSnapshotManifestSha256",
        "tDrySnapshotManifestSha256",
        "eventChainHeadSha256",
        "rawReferencesVerified",
        "orphanTailsAbsent",
        "immutableVerified"
      ],
      "properties": {
        "terminalStatus": {
          "const": "completed"
        },
        "coreTreeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "coreSealSha256": {
          "$ref": "#/$defs/sha256"
        },
        "tDoneSnapshotManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "tDrySnapshotManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "eventChainHeadSha256": {
          "$ref": "#/$defs/sha256"
        },
        "rawReferencesVerified": {
          "const": true
        },
        "orphanTailsAbsent": {
          "const": true
        },
        "immutableVerified": {
          "const": true
        }
      }
    },
    "postprocess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentCoreSealSha256",
        "gradeSets",
        "deterministicGateResultsSha256",
        "secondaryReviewSha256",
        "aiAdjudicationSha256",
        "humanAuditQueueSha256",
        "humanValidationStatus",
        "humanValidatedCompositeClaim",
        "finalReportSha256",
        "reportSchemaSha256",
        "postprocessTreeSha256",
        "postprocessSealSha256",
        "appendOnlyVerified",
        "freshProcessVerified"
      ],
      "properties": {
        "parentCoreSealSha256": {
          "$ref": "#/$defs/sha256"
        },
        "gradeSets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "milestone",
              "bundleSha256",
              "gradingPlanSha256",
              "graderAGradeSha256",
              "graderBGradeSha256",
              "graderAArmGuessSha256",
              "graderBArmGuessSha256",
              "adjudicationSha256",
              "adjudicationRecordSha256",
              "parentCoreSealSha256",
              "humanAuditQueueSha256"
            ],
            "properties": {
              "milestone": {
                "enum": [
                  "t_done",
                  "t_dry"
                ]
              },
              "bundleSha256": {
                "$ref": "#/$defs/sha256"
              },
              "gradingPlanSha256": {
                "$ref": "#/$defs/sha256"
              },
              "graderAGradeSha256": {
                "$ref": "#/$defs/sha256"
              },
              "graderBGradeSha256": {
                "$ref": "#/$defs/sha256"
              },
              "graderAArmGuessSha256": {
                "$ref": "#/$defs/sha256"
              },
              "graderBArmGuessSha256": {
                "$ref": "#/$defs/sha256"
              },
              "adjudicationSha256": {
                "$ref": "#/$defs/sha256"
              },
              "adjudicationRecordSha256": {
                "$ref": "#/$defs/sha256"
              },
              "parentCoreSealSha256": {
                "$ref": "#/$defs/sha256"
              },
              "humanAuditQueueSha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "milestone": {
                    "const": "t_done"
                  }
                },
                "required": [
                  "milestone"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "milestone": {
                    "const": "t_dry"
                  }
                },
                "required": [
                  "milestone"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "deterministicGateResultsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "secondaryReviewSha256": {
          "$ref": "#/$defs/sha256"
        },
        "aiAdjudicationSha256": {
          "$ref": "#/$defs/sha256"
        },
        "humanAuditQueueSha256": {
          "$ref": "#/$defs/sha256"
        },
        "humanValidationStatus": {
          "enum": [
            "pending",
            "completed"
          ]
        },
        "humanValidatedCompositeClaim": {
          "type": "boolean"
        },
        "finalReportSha256": {
          "$ref": "#/$defs/sha256"
        },
        "reportSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "postprocessTreeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "postprocessSealSha256": {
          "$ref": "#/$defs/sha256"
        },
        "appendOnlyVerified": {
          "const": true
        },
        "freshProcessVerified": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "humanValidationStatus": {
                "const": "pending"
              }
            },
            "required": [
              "humanValidationStatus"
            ]
          },
          "then": {
            "properties": {
              "humanValidatedCompositeClaim": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "retainedRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "coreTreeSha256",
        "postprocessTreeSha256",
        "finalRecordTreeSha256",
        "workspacePath",
        "retainedTreeSha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^benchmark/result/(todo|reddit|shopping|erp)/(plain|evidence)/runs/[a-z0-9][a-z0-9._-]{5,127}$"
        },
        "coreTreeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "postprocessTreeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "finalRecordTreeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "workspacePath": {
          "type": "string",
          "pattern": "^benchmark/result/(todo|reddit|shopping|erp)/(plain|evidence)/runs/[a-z0-9][a-z0-9._-]{5,127}/workspace$"
        },
        "retainedTreeSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "latestPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "previousRunId",
        "currentRunId",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^benchmark/result/(todo|reddit|shopping|erp)/(plain|evidence)/latest\\.json$"
        },
        "previousRunId": {
          "type": [
            "string",
            "null"
          ]
        },
        "currentRunId": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "demoWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMilestone",
        "sourceSnapshotManifestSha256",
        "path",
        "retainedTreeSha256"
      ],
      "properties": {
        "sourceMilestone": {
          "const": "t_dry"
        },
        "sourceSnapshotManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "path": {
          "type": "string",
          "pattern": "^benchmark/result/(todo|reddit|shopping|erp)/(plain|evidence)/workspace$"
        },
        "retainedTreeSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "gitRoundTrip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectFormat",
        "temporaryCommitOid",
        "sourceTreeSha256",
        "cloneTreeSha256",
        "sourceSnapshotManifestSha256",
        "cloneSnapshotManifestSha256",
        "sourceCoreSealSha256",
        "cloneCoreSealSha256",
        "allDigestsMatch"
      ],
      "properties": {
        "objectFormat": {
          "const": "sha1"
        },
        "temporaryCommitOid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sourceTreeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "cloneTreeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceSnapshotManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "cloneSnapshotManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceCoreSealSha256": {
          "$ref": "#/$defs/sha256"
        },
        "cloneCoreSealSha256": {
          "$ref": "#/$defs/sha256"
        },
        "allDigestsMatch": {
          "const": true
        }
      }
    },
    "priorRunSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beforeCoreSealSetSha256",
        "afterCoreSealSetSha256",
        "priorCoreSealsPreserved",
        "existingPostprocessPrefixesPreserved"
      ],
      "properties": {
        "beforeCoreSealSetSha256": {
          "$ref": "#/$defs/sha256"
        },
        "afterCoreSealSetSha256": {
          "$ref": "#/$defs/sha256"
        },
        "priorCoreSealsPreserved": {
          "const": true
        },
        "existingPostprocessPrefixesPreserved": {
          "const": true
        }
      }
    },
    "concurrencyControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockId",
        "expectedPreviousLatestSha256",
        "compareAndSwapSucceeded"
      ],
      "properties": {
        "lockId": {
          "type": "string",
          "minLength": 1
        },
        "expectedPreviousLatestSha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "compareAndSwapSucceeded": {
          "const": true
        }
      }
    },
    "promotedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "manifestSha256": {
      "description": "SHA-256 of RFC 8785 canonical JSON for this manifest with manifestSha256 omitted.",
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
