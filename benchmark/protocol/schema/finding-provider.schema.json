{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/finding-provider.schema.json",
  "title": "Provider-facing Phase 2 finder output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "role",
    "round",
    "assignmentId",
    "lenses",
    "status",
    "interruption",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "finder"
      ]
    },
    "round": {
      "type": "integer"
    },
    "assignmentId": {
      "type": "string",
      "enum": [
        "F1-requirements-database",
        "F2-api-logic",
        "F3-tests",
        "F4-frontend"
      ]
    },
    "lenses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "requirements",
          "database",
          "api",
          "logic",
          "tests",
          "frontend"
        ]
      }
    },
    "status": {
      "enum": [
        "completed",
        "interrupted",
        "failed"
      ]
    },
    "interruption": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "reason",
        "lastCompletedStep"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "lastCompletedStep": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId",
          "lens",
          "atomicClauseIds",
          "artifactLocations",
          "expectedBehavior",
          "observedBehavior",
          "verificationProcedure",
          "finderConfidence"
        ],
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "lens": {
            "type": "string",
            "enum": [
              "requirements",
              "database",
              "api",
              "logic",
              "tests",
              "frontend"
            ]
          },
          "atomicClauseIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifactLocations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "line",
                "symbol"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer"
                },
                "symbol": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "expectedBehavior": {
            "type": "string"
          },
          "observedBehavior": {
            "type": "string"
          },
          "verificationProcedure": {
            "type": "string"
          },
          "finderConfidence": {
            "type": "number"
          }
        }
      }
    }
  }
}
