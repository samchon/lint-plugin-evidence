{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/grade-block-local.schema.json",
  "title": "Local blind grade block adjudication",
  "allOf": [
    {
      "$ref": "grade-block-provider.schema.json"
    },
    {
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "role": {
          "const": "blind_grader"
        },
        "gradeId": {
          "minLength": 1
        },
        "bundleId": {
          "minLength": 1
        },
        "graderPseudonym": {
          "minLength": 1
        },
        "rubricSha256": {
          "pattern": "^[a-f0-9]{64}$"
        },
        "catalogSha256": {
          "pattern": "^[a-f0-9]{64}$"
        },
        "blockId": {
          "minLength": 1
        },
        "blockIndex": {
          "minimum": 0
        },
        "criterionIds": {
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "minLength": 1
          }
        },
        "ratings": {
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "properties": {
              "criterionId": {
                "minLength": 1
              },
              "confidence": {
                "minimum": 0,
                "maximum": 1
              },
              "surfaces": {
                "minItems": 8,
                "maxItems": 8,
                "uniqueItems": true
              },
              "test": {
                "properties": {
                  "counterfactual": {
                    "minLength": 1
                  }
                }
              },
              "evidence": {
                "items": {
                  "properties": {
                    "path": {
                      "minLength": 1
                    },
                    "line": {
                      "minimum": 1
                    },
                    "observation": {
                      "minLength": 1
                    }
                  }
                }
              },
              "rationale": {
                "minLength": 1
              }
            }
          }
        },
        "interruption": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "reason": {
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "interruption": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "interruption": {
            "type": "object"
          }
        }
      }
    }
  ]
}
