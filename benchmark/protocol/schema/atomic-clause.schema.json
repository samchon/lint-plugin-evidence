{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/atomic-clause.schema.json",
  "title": "One frozen acceptance-criteria JSONL record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "requirement",
    "source",
    "criterion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9-]+\\.AC-[0-9]{2}$"
    },
    "requirement": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9-]+$"
    },
    "source": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9-]+\\.md$"
    },
    "criterion": {
      "type": "string",
      "minLength": 1
    }
  }
}
