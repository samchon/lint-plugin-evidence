{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/adjudicator-process-provenance.schema.json",
  "title": "Fresh adjudicator process provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "parentCoreSealSha256",
    "provider",
    "modelId",
    "reasoningEffort",
    "codexVersion",
    "authClass",
    "serviceTierClass",
    "serviceTierSymbolic",
    "requestedServiceTier",
    "serviceTierRequestMode",
    "effectiveServiceTier",
    "assignmentId",
    "assignmentPath",
    "assignmentSha256",
    "threadId",
    "sessionId",
    "agentId",
    "responseIds",
    "processNonce",
    "pid",
    "transportSessionId",
    "startedAtMonotonicNs",
    "executableSha256",
    "invocation",
    "runnerEventLogPath",
    "runnerEventLogSha256",
    "processStartEvent",
    "rawEventStreamPath",
    "rawEventStreamSha256",
    "usagePath",
    "usageSha256",
    "providerOutputSha256",
    "startedAtUtc",
    "completedAtUtc"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "parentCoreSealSha256": {
      "$ref": "#/$defs/sha256"
    },
    "provider": {
      "const": "openai"
    },
    "modelId": {
      "const": "gpt-5.6-terra"
    },
    "reasoningEffort": {
      "const": "high"
    },
    "codexVersion": {
      "const": "0.145.0"
    },
    "authClass": {
      "const": "chatgpt"
    },
    "serviceTierClass": {
      "const": "standard"
    },
    "serviceTierSymbolic": {
      "const": "default"
    },
    "requestedServiceTier": {
      "type": "null"
    },
    "serviceTierRequestMode": {
      "const": "omitted"
    },
    "effectiveServiceTier": {
      "type": "null"
    },
    "assignmentId": {
      "type": "string",
      "minLength": 1
    },
    "assignmentPath": {
      "type": "string",
      "pattern": "^postprocess/adjudication/assignment/[a-z0-9][a-z0-9._-]{5,127}\\.json$"
    },
    "assignmentSha256": {
      "$ref": "#/$defs/sha256"
    },
    "threadId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "responseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "processNonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "transportSessionId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "startedAtMonotonicNs": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "executableSha256": {
      "$ref": "#/$defs/sha256"
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "arguments",
        "cwd",
        "environmentSha256"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "environmentSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runnerEventLogPath": {
      "const": "logs/runner.events.jsonl"
    },
    "runnerEventLogSha256": {
      "$ref": "#/$defs/sha256"
    },
    "processStartEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "eventSha256",
        "monotonicNs"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "eventSha256": {
          "$ref": "#/$defs/sha256"
        },
        "monotonicNs": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "rawEventStreamPath": {
      "type": "string",
      "pattern": "^postprocess/adjudication/events/[a-z0-9][a-z0-9._-]{5,127}\\.json$"
    },
    "rawEventStreamSha256": {
      "$ref": "#/$defs/sha256"
    },
    "usagePath": {
      "type": "string",
      "pattern": "^postprocess/adjudication/usage/[a-z0-9][a-z0-9._-]{5,127}\\.json$"
    },
    "usageSha256": {
      "$ref": "#/$defs/sha256"
    },
    "providerOutputSha256": {
      "$ref": "#/$defs/sha256"
    },
    "startedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "completedAtUtc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
