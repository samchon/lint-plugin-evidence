{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/snapshot-manifest.schema.json",
  "title": "Reproducible benchmark project snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "milestone",
    "capturedAtUtc",
    "exclusionPolicy",
    "liveWorkspaceInventorySha256",
    "liveWorkspaceTreeSha256",
    "retainedRoot",
    "retainedEntries",
    "excludedRoots",
    "requiredClassChecks",
    "producerValidation",
    "retainedTreeSha256",
    "physicalWorkspaceArchive",
    "manifestSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$"
    },
    "milestone": {
      "enum": [
        "t_done",
        "t_dry",
        "terminal"
      ]
    },
    "capturedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "exclusionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rulesSha256",
        "templateGitignoreSha256",
        "independentOfGitignore",
        "driftReportSha256",
        "unreviewedDifferences"
      ],
      "properties": {
        "rulesSha256": {
          "$ref": "#/$defs/sha256"
        },
        "templateGitignoreSha256": {
          "$ref": "#/$defs/sha256"
        },
        "independentOfGitignore": {
          "const": true
        },
        "driftReportSha256": {
          "$ref": "#/$defs/sha256"
        },
        "unreviewedDifferences": {
          "const": 0
        }
      }
    },
    "liveWorkspaceInventorySha256": {
      "$ref": "#/$defs/sha256"
    },
    "liveWorkspaceTreeSha256": {
      "$ref": "#/$defs/sha256"
    },
    "retainedRoot": {
      "type": "string",
      "pattern": "^snapshots/(t_done|t_dry|terminal)/project$"
    },
    "retainedEntries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/retainedEntry"
      }
    },
    "excludedRoots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/excludedRoot"
      }
    },
    "requiredClassChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "tests",
        "configuration",
        "documentation",
        "packageManifests",
        "lockfile",
        "databaseDefinitions",
        "staticAssets",
        "evidenceTarball"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/requiredClass"
        },
        "tests": {
          "$ref": "#/$defs/requiredClass"
        },
        "configuration": {
          "$ref": "#/$defs/requiredClass"
        },
        "documentation": {
          "$ref": "#/$defs/requiredClass"
        },
        "packageManifests": {
          "$ref": "#/$defs/requiredClass"
        },
        "lockfile": {
          "$ref": "#/$defs/requiredClass"
        },
        "databaseDefinitions": {
          "$ref": "#/$defs/optionalClass"
        },
        "staticAssets": {
          "$ref": "#/$defs/optionalClass"
        },
        "evidenceTarball": {
          "$ref": "#/$defs/optionalClass"
        }
      }
    },
    "producerValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uniqueNormalizedSortedPaths",
        "exactRetainedFileSet",
        "entryBytesAndModesVerified",
        "excludedRootsNonOverlapping",
        "retainedAndExcludedDisjoint",
        "requiredClassesBoundToEntries"
      ],
      "properties": {
        "uniqueNormalizedSortedPaths": {
          "const": true
        },
        "exactRetainedFileSet": {
          "const": true
        },
        "entryBytesAndModesVerified": {
          "const": true
        },
        "excludedRootsNonOverlapping": {
          "const": true
        },
        "retainedAndExcludedDisjoint": {
          "const": true
        },
        "requiredClassesBoundToEntries": {
          "const": true
        }
      }
    },
    "retainedTreeSha256": {
      "$ref": "#/$defs/sha256"
    },
    "physicalWorkspaceArchive": {
      "description": "Optional separately owned full physical archive; never the canonical project snapshot.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "path",
            "byteLength",
            "sha256",
            "retentionPolicy"
          ],
          "properties": {
            "owner": {
              "const": "run-record"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "retentionPolicy": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "manifestSha256": {
      "description": "SHA-256 of RFC 8785 canonical JSON for this manifest with manifestSha256 omitted.",
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "retainedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "executable",
        "byteLength",
        "contentSha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "kind": {
          "enum": [
            "file",
            "symlink"
          ]
        },
        "executable": {
          "type": "boolean"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "requiredClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "paths"
      ],
      "properties": {
        "status": {
          "const": "retained"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    },
    "optionalClass": {
      "oneOf": [
        {
          "$ref": "#/$defs/requiredClass"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "paths"
          ],
          "properties": {
            "status": {
              "const": "not_applicable"
            },
            "paths": {
              "const": []
            }
          }
        }
      ]
    },
    "excludedRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reason",
        "descendantCount",
        "byteLength",
        "treeSha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "reason": {
          "enum": [
            "vcs-administration",
            "installed-dependency",
            "package-manager-store",
            "build-output",
            "coverage-output",
            "generated-documentation",
            "tool-cache",
            "temporary-file",
            "runtime-database",
            "browser-test-output",
            "harness-output"
          ]
        },
        "descendantCount": {
          "type": "integer",
          "minimum": 1
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "treeSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
