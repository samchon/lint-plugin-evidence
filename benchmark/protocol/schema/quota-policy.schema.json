{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/quota-policy.schema.json",
  "title": "Non-sensitive native quota authorization policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "sourceClass",
    "guardRelation",
    "thresholdClass",
    "authorizationCondition",
    "windowClasses",
    "sparseUpdatePolicy",
    "resetSemantics",
    "numericConversion",
    "privateCheckpoint",
    "sanitizedAttestation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "policyId": {
      "const": "chatgpt-native-first-hit-v1"
    },
    "sourceClass": {
      "const": "chatgpt-native-rate-limit"
    },
    "guardRelation": {
      "const": "independent-first-hit-or"
    },
    "thresholdClass": {
      "const": "provider-native-reached-or-spend-control"
    },
    "authorizationCondition": {
      "const": "all-applicable-windows-pass"
    },
    "windowClasses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "individual",
        "spendControl"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/window"
        },
        "secondary": {
          "$ref": "#/$defs/window"
        },
        "individual": {
          "$ref": "#/$defs/window"
        },
        "spendControl": {
          "$ref": "#/$defs/window"
        }
      }
    },
    "sparseUpdatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialFullReadRequired",
        "omittedWindowOnUpdate",
        "unavailableFullRead",
        "nullWindowOnFullSnapshot"
      ],
      "properties": {
        "initialFullReadRequired": {
          "const": true
        },
        "omittedWindowOnUpdate": {
          "const": "refetch-full-snapshot-before-decision"
        },
        "unavailableFullRead": {
          "const": "fail-closed"
        },
        "nullWindowOnFullSnapshot": {
          "const": "not_applicable"
        }
      }
    },
    "resetSemantics": {
      "const": "observational-only-never-derive-token-allowance"
    },
    "numericConversion": {
      "const": "forbidden"
    },
    "privateCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persistence",
        "promoted",
        "destroyAfterAttestation"
      ],
      "properties": {
        "persistence": {
          "const": "memory-only-until-attestation"
        },
        "promoted": {
          "const": false
        },
        "destroyAfterAttestation": {
          "const": true
        }
      }
    },
    "sanitizedAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithmId",
        "canonicalization",
        "projectionFields",
        "rawTelemetryFieldsForbidden"
      ],
      "properties": {
        "algorithmId": {
          "const": "sha256-rfc8785-sanitized-quota-attestation-v1"
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "projectionFields": {
          "const": [
            "sourceClass",
            "windowResults",
            "passedAtAuthorization",
            "policyId",
            "policyPath",
            "policySha256",
            "capturedAtUtc",
            "attestationAlgorithmId",
            "privateCheckpointPersistence",
            "exactTelemetryPromoted",
            "guardRelation"
          ]
        },
        "rawTelemetryFieldsForbidden": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nullableOnFullSnapshot",
        "nativeReachedStops"
      ],
      "properties": {
        "nullableOnFullSnapshot": {
          "const": true
        },
        "nativeReachedStops": {
          "const": true
        }
      }
    }
  }
}
