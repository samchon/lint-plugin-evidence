{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/arm-guess-local.schema.json",
  "title": "Local post-grade arm guess",
  "allOf": [
    {
      "$ref": "arm-guess-provider.schema.json"
    },
    {
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "role": {
          "const": "blind_arm_guess"
        },
        "gradeId": {
          "minLength": 1
        },
        "bundleId": {
          "minLength": 1
        },
        "graderPseudonym": {
          "minLength": 1
        },
        "sealedRatingsSha256": {
          "pattern": "^[a-f0-9]{64}$"
        },
        "confidence": {
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "minLength": 1
        }
      }
    }
  ]
}
