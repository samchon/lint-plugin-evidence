{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/usage-report.schema.json",
  "title": "Exact Codex usage report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exactUsageComplete",
    "accumulatedUsageReconciled",
    "responses",
    "duplicateResponseIds",
    "exactTotal",
    "exactByThread",
    "latestThreadUsage",
    "reconciliation",
    "anomalies"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "exactUsageComplete": {
      "type": "boolean"
    },
    "accumulatedUsageReconciled": {
      "type": "boolean"
    },
    "responses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/response"
      }
    },
    "duplicateResponseIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exactTotal": {
      "$ref": "#/$defs/tokens"
    },
    "exactByThread": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/tokens"
      }
    },
    "latestThreadUsage": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/threadUsage"
      }
    },
    "reconciliation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/difference"
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responseId",
        "threadId",
        "turnId",
        "phase",
        "receivedMonotonicNs",
        "rawEventId",
        "usage",
        "receivedAtUtc"
      ],
      "properties": {
        "responseId": {
          "type": "string",
          "minLength": 1
        },
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "setup",
            "phase1",
            "completion_challenge",
            "phase2_discovery",
            "phase2_fix",
            "grading",
            "terminal"
          ]
        },
        "receivedMonotonicNs": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "rawEventId": {
          "$ref": "#/$defs/sha256"
        },
        "usage": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/tokens"
            }
          ]
        },
        "receivedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "threadUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "turnId",
        "last",
        "total",
        "receivedAtUtc"
      ],
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "last": {
          "$ref": "#/$defs/tokens"
        },
        "total": {
          "$ref": "#/$defs/tokens"
        },
        "receivedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "exact",
        "accumulated",
        "difference"
      ],
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "exact": {
          "$ref": "#/$defs/tokens"
        },
        "accumulated": {
          "$ref": "#/$defs/tokens"
        },
        "difference": {
          "$ref": "#/$defs/signedTokens"
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalTokens",
        "inputTokens",
        "cachedInputTokens",
        "cacheWriteInputTokens",
        "outputTokens",
        "reasoningOutputTokens"
      ],
      "properties": {
        "totalTokens": {
          "type": "integer",
          "minimum": 0
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cachedInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cacheWriteInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoningOutputTokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "signedTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalTokens",
        "inputTokens",
        "cachedInputTokens",
        "cacheWriteInputTokens",
        "outputTokens",
        "reasoningOutputTokens"
      ],
      "properties": {
        "totalTokens": {
          "type": "integer"
        },
        "inputTokens": {
          "type": "integer"
        },
        "cachedInputTokens": {
          "type": "integer"
        },
        "cacheWriteInputTokens": {
          "type": "integer"
        },
        "outputTokens": {
          "type": "integer"
        },
        "reasoningOutputTokens": {
          "type": "integer"
        }
      }
    }
  }
}
