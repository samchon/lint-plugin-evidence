{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/usage-report.schema.json",
  "title": "Exact Codex response usage, settings, price, and spend report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "expectedModel",
    "expectedReasoningEffort",
    "expectedServiceTier",
    "providerModelFallbackAllowed",
    "exactUsageComplete",
    "threadSettings",
    "turnRequests",
    "responses",
    "duplicateResponseIds",
    "exactTotal",
    "normalizedTotal",
    "exactByThread",
    "latestThreadUsage",
    "reconciliation",
    "priceSheetSha256",
    "authorization",
    "cumulativeProviderCredits",
    "budgetOutcome",
    "settingsMismatches",
    "anomalies"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "expectedModel": {
      "const": "gpt-5.6-terra"
    },
    "expectedReasoningEffort": {
      "const": "high"
    },
    "expectedServiceTier": {
      "const": "default"
    },
    "providerModelFallbackAllowed": {
      "const": false
    },
    "exactUsageComplete": {
      "const": true
    },
    "threadSettings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/threadSettings"
      }
    },
    "turnRequests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/turnRequest"
      }
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/response"
      }
    },
    "duplicateResponseIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exactTotal": {
      "$ref": "#/$defs/rawTokens"
    },
    "normalizedTotal": {
      "$ref": "#/$defs/normalizedTokens"
    },
    "exactByThread": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/rawTokens"
      }
    },
    "latestThreadUsage": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/threadUsage"
      }
    },
    "reconciliation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/difference"
      }
    },
    "priceSheetSha256": {
      "$ref": "#/$defs/sha256"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "currency",
        "maximumProviderCredits"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "const": "PROVIDER_CREDITS"
        },
        "maximumProviderCredits": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "cumulativeProviderCredits": {
      "type": "number",
      "minimum": 0
    },
    "budgetOutcome": {
      "enum": [
        "below_ceiling",
        "atomic_response_overshoot"
      ]
    },
    "settingsMismatches": {
      "const": []
    },
    "anomalies": {
      "const": []
    }
  },
  "$defs": {
    "threadSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "requestedModel",
        "requestedReasoningEffort",
        "requestedServiceTier",
        "allowProviderModelFallback",
        "effectiveModel",
        "effectiveModelProvider",
        "effectiveServiceTier",
        "source",
        "sourceSchemaSha256",
        "matched"
      ],
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "requestedModel": {
          "const": "gpt-5.6-terra"
        },
        "requestedReasoningEffort": {
          "const": "high"
        },
        "requestedServiceTier": {
          "const": "default"
        },
        "allowProviderModelFallback": {
          "const": false
        },
        "effectiveModel": {
          "const": "gpt-5.6-terra"
        },
        "effectiveModelProvider": {
          "type": "string",
          "minLength": 1
        },
        "effectiveServiceTier": {
          "const": "default"
        },
        "source": {
          "const": "thread/start response"
        },
        "sourceSchemaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "matched": {
          "const": true
        }
      }
    },
    "turnRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "turnId",
        "model",
        "reasoningEffort",
        "serviceTier",
        "matched"
      ],
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "const": "gpt-5.6-terra"
        },
        "reasoningEffort": {
          "const": "high"
        },
        "serviceTier": {
          "const": "default"
        },
        "matched": {
          "const": true
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responseId",
        "threadId",
        "turnId",
        "usage",
        "normalized",
        "pricing",
        "receivedAtUtc"
      ],
      "properties": {
        "responseId": {
          "type": "string",
          "minLength": 1
        },
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "$ref": "#/$defs/rawTokens"
        },
        "normalized": {
          "$ref": "#/$defs/normalizedTokens"
        },
        "pricing": {
          "$ref": "#/$defs/responsePricing"
        },
        "receivedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "responsePricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creditsBefore",
        "responseCredits",
        "creditsAfter",
        "ceiling",
        "overshoot",
        "stopBeforeNextRequest"
      ],
      "properties": {
        "creditsBefore": {
          "type": "number",
          "minimum": 0
        },
        "responseCredits": {
          "type": "number",
          "minimum": 0
        },
        "creditsAfter": {
          "type": "number",
          "minimum": 0
        },
        "ceiling": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "overshoot": {
          "type": "number",
          "minimum": 0
        },
        "stopBeforeNextRequest": {
          "type": "boolean"
        }
      }
    },
    "threadUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "turnId",
        "last",
        "total",
        "receivedAtUtc"
      ],
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "last": {
          "$ref": "#/$defs/rawTokens"
        },
        "total": {
          "$ref": "#/$defs/rawTokens"
        },
        "receivedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "exact",
        "accumulated",
        "difference"
      ],
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "exact": {
          "$ref": "#/$defs/rawTokens"
        },
        "accumulated": {
          "$ref": "#/$defs/rawTokens"
        },
        "difference": {
          "$ref": "#/$defs/signedTokens"
        }
      }
    },
    "rawTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalTokens",
        "inputTokens",
        "cachedInputTokens",
        "cacheWriteInputTokens",
        "outputTokens",
        "reasoningOutputTokens"
      ],
      "properties": {
        "totalTokens": {
          "type": "integer",
          "minimum": 0
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cachedInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cacheWriteInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoningOutputTokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "normalizedTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nonCachedInputTokens",
        "cacheReadInputTokens",
        "cacheWriteInputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "providerTotalTokens"
      ],
      "properties": {
        "nonCachedInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cacheReadInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "cacheWriteInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoningOutputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "providerTotalTokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "signedTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalTokens",
        "inputTokens",
        "cachedInputTokens",
        "cacheWriteInputTokens",
        "outputTokens",
        "reasoningOutputTokens"
      ],
      "properties": {
        "totalTokens": {
          "type": "integer"
        },
        "inputTokens": {
          "type": "integer"
        },
        "cachedInputTokens": {
          "type": "integer"
        },
        "cacheWriteInputTokens": {
          "type": "integer"
        },
        "outputTokens": {
          "type": "integer"
        },
        "reasoningOutputTokens": {
          "type": "integer"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
