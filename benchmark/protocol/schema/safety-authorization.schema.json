{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/safety-authorization.schema.json",
  "title": "Subject- and wave-scoped safety authorization pins",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "unit",
    "maximumObservedTotalTokensBySubject",
    "hardWallDurationSecondsBySubject",
    "maximumObservedBlockTotalTokensByWave",
    "blockHardWallDurationSecondsByWave",
    "armParity",
    "hardCeilingGuaranteed",
    "monetaryStatus",
    "costReportSchemaPath",
    "costReportFixturePath"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "unit": {
      "const": "provider_total_tokens"
    },
    "maximumObservedTotalTokensBySubject": {
      "$ref": "#/$defs/subjectMap"
    },
    "hardWallDurationSecondsBySubject": {
      "$ref": "#/$defs/subjectMap"
    },
    "maximumObservedBlockTotalTokensByWave": {
      "$ref": "#/$defs/waveMap"
    },
    "blockHardWallDurationSecondsByWave": {
      "$ref": "#/$defs/waveMap"
    },
    "armParity": {
      "const": "identical-within-subject-and-replicate"
    },
    "hardCeilingGuaranteed": {
      "const": false
    },
    "monetaryStatus": {
      "const": "unavailable"
    },
    "costReportSchemaPath": {
      "const": "benchmark/protocol/schema/cost-report.schema.json"
    },
    "costReportFixturePath": {
      "const": "benchmark/protocol/fixtures/cost-report/cases.json"
    }
  },
  "$defs": {
    "nullablePositiveInteger": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "subjectMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "todo",
        "reddit",
        "shopping",
        "erp"
      ],
      "properties": {
        "todo": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "reddit": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "shopping": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "erp": {
          "$ref": "#/$defs/nullablePositiveInteger"
        }
      }
    },
    "waveMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "todo-reddit",
        "shopping-erp"
      ],
      "properties": {
        "todo-reddit": {
          "$ref": "#/$defs/nullablePositiveInteger"
        },
        "shopping-erp": {
          "$ref": "#/$defs/nullablePositiveInteger"
        }
      }
    }
  }
}
