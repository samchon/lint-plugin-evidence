{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/grading-input-manifest.schema.json",
  "title": "Pre-seal grading input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "runManifestSha256",
    "subjectFreezeManifestSha256",
    "requirementsRawTreeSha256",
    "acceptanceCatalogSha256",
    "contextCatalogSha256",
    "tDoneSourceRawTree",
    "tDoneBundleRawTree",
    "tDrySourceRawTree",
    "tDryBundleRawTree",
    "rubricSha256",
    "promptSha256",
    "providerOutputRegistrySha256",
    "qualityInputsSha256",
    "protocolRevisionSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "runManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "subjectFreezeManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "requirementsRawTreeSha256": {
      "$ref": "#/$defs/sha256"
    },
    "acceptanceCatalogSha256": {
      "$ref": "#/$defs/sha256"
    },
    "contextCatalogSha256": {
      "$ref": "#/$defs/nullableSha256"
    },
    "tDoneSourceRawTree": {
      "$ref": "#/$defs/rawTreeDigest"
    },
    "tDoneBundleRawTree": {
      "$ref": "#/$defs/rawTreeDigest"
    },
    "tDrySourceRawTree": {
      "$ref": "#/$defs/rawTreeDigest"
    },
    "tDryBundleRawTree": {
      "$ref": "#/$defs/rawTreeDigest"
    },
    "rubricSha256": {
      "$ref": "#/$defs/sha256"
    },
    "promptSha256": {
      "$ref": "#/$defs/sha256"
    },
    "providerOutputRegistrySha256": {
      "$ref": "#/$defs/sha256"
    },
    "qualityInputsSha256": {
      "$ref": "#/$defs/sha256"
    },
    "protocolRevisionSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "rawTreeDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithmId",
        "sha256"
      ],
      "properties": {
        "algorithmId": {
          "const": "sha256-posix-path-nul-bytes-v1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nullableSha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
