{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/grading-block-plan.schema.json",
  "title": "Deterministic blind grading block plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "runId",
    "bundleId",
    "bundleSha256",
    "parentCoreSealSha256",
    "subject",
    "phase",
    "subjectFreezeManifestSha256",
    "requirementsRawTreeSha256",
    "rubricSha256",
    "graderPromptSha256",
    "gradeBlockProviderSchemaSha256",
    "gradeBlockLocalSchemaSha256",
    "armGuessProviderSchemaSha256",
    "armGuessLocalSchemaSha256",
    "providerOutputRegistrySha256",
    "protocolRevisionSha256",
    "blockSize",
    "graderAssignments",
    "populations",
    "partitionValidation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "bundleId": {
      "type": "string",
      "minLength": 1
    },
    "bundleSha256": {
      "$ref": "#/$defs/sha256"
    },
    "parentCoreSealSha256": {
      "$ref": "#/$defs/sha256"
    },
    "subject": {
      "enum": [
        "todo",
        "reddit",
        "shopping",
        "erp"
      ]
    },
    "phase": {
      "enum": [
        "t_done",
        "t_dry"
      ]
    },
    "rubricSha256": {
      "$ref": "#/$defs/sha256"
    },
    "subjectFreezeManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "requirementsRawTreeSha256": {
      "$ref": "#/$defs/sha256"
    },
    "graderPromptSha256": {
      "$ref": "#/$defs/sha256"
    },
    "gradeBlockProviderSchemaSha256": {
      "$ref": "#/$defs/sha256"
    },
    "gradeBlockLocalSchemaSha256": {
      "$ref": "#/$defs/sha256"
    },
    "armGuessProviderSchemaSha256": {
      "$ref": "#/$defs/sha256"
    },
    "armGuessLocalSchemaSha256": {
      "$ref": "#/$defs/sha256"
    },
    "providerOutputRegistrySha256": {
      "$ref": "#/$defs/sha256"
    },
    "protocolRevisionSha256": {
      "$ref": "#/$defs/sha256"
    },
    "blockSize": {
      "const": 50
    },
    "graderAssignments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pseudonym",
          "model",
          "reasoningEffort",
          "assignmentSha256"
        ],
        "properties": {
          "pseudonym": {
            "enum": [
              "blind-grader-a",
              "blind-grader-b"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "reasoningEffort": {
            "type": "string",
            "minLength": 1
          },
          "assignmentSha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "populations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "population",
          "catalogSha256",
          "catalogCount",
          "orderedCriterionIdsSha256",
          "blocks"
        ],
        "properties": {
          "population": {
            "enum": [
              "acceptance",
              "context"
            ]
          },
          "catalogSha256": {
            "$ref": "#/$defs/sha256"
          },
          "catalogCount": {
            "type": "integer",
            "minimum": 1
          },
          "orderedCriterionIdsSha256": {
            "$ref": "#/$defs/sha256"
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "blockId",
                "blockIndex",
                "criterionIds",
                "criterionIdsSha256"
              ],
              "properties": {
                "blockId": {
                  "type": "string",
                  "minLength": 1
                },
                "blockIndex": {
                  "type": "integer",
                  "minimum": 0
                },
                "criterionIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 50,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "criterionIdsSha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        }
      }
    },
    "partitionValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogOrderPreserved",
        "exactUnion",
        "nonOverlapping",
        "uniqueIds",
        "countsReconciled"
      ],
      "properties": {
        "catalogOrderPreserved": {
          "const": true
        },
        "exactUnion": {
          "const": true
        },
        "nonOverlapping": {
          "const": true
        },
        "uniqueIds": {
          "const": true
        },
        "countsReconciled": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
