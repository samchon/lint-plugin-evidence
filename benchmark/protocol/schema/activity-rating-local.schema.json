{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/activity-rating-local.schema.json",
  "title": "Local response activity attribution block",
  "allOf": [
    {
      "$ref": "activity-rating-provider.schema.json"
    },
    {
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "role": {
          "const": "activity_rater"
        },
        "runId": {
          "minLength": 1
        },
        "blockId": {
          "minLength": 1
        },
        "responseIds": {
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "minLength": 1
          }
        },
        "ratings": {
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "properties": {
              "responseId": {
                "minLength": 1
              },
              "probabilityBasisPoints": {
                "additionalProperties": {
                  "minimum": 0,
                  "maximum": 10000
                }
              },
              "secondaryMechanisms": {
                "uniqueItems": true
              },
              "confidence": {
                "minimum": 0,
                "maximum": 1
              },
              "rationale": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
