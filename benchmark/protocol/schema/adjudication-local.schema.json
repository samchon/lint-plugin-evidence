{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/adjudication-local.schema.json",
  "title": "Local fresh AI adjudication",
  "allOf": [
    {
      "$ref": "adjudication-provider.schema.json"
    },
    {
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "role": {
          "const": "llm_adjudicator"
        },
        "adjudicationId": {
          "minLength": 1
        },
        "bundleId": {
          "minLength": 1
        },
        "sealedInputsSha256": {
          "pattern": "^[a-f0-9]{64}$"
        },
        "queueSha256": {
          "pattern": "^[a-f0-9]{64}$"
        },
        "decisions": {
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "properties": {
              "itemId": {
                "minLength": 1
              },
              "decision": {
                "minLength": 1
              },
              "confidence": {
                "minimum": 0,
                "maximum": 1
              },
              "rationale": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
