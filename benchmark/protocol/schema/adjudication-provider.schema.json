{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/adjudication-provider.schema.json",
  "title": "Provider-facing fresh AI adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "role",
    "adjudicationId",
    "bundleId",
    "subject",
    "phase",
    "population",
    "sealedInputsSha256",
    "queueSha256",
    "decisions",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "llm_adjudicator"
      ]
    },
    "adjudicationId": {
      "type": "string"
    },
    "bundleId": {
      "type": "string"
    },
    "subject": {
      "type": "string",
      "enum": [
        "todo",
        "reddit",
        "shopping",
        "erp"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "t_done",
        "t_dry"
      ]
    },
    "population": {
      "type": "string",
      "enum": [
        "acceptance",
        "context",
        "secondary",
        "activity"
      ]
    },
    "sealedInputsSha256": {
      "type": "string"
    },
    "queueSha256": {
      "type": "string"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "decision",
          "confidence",
          "rationale"
        ],
        "properties": {
          "itemId": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "semantic_consensus",
              "secondary_consensus",
              "activity_consensus"
            ]
          },
          "semanticRating": {
            "$ref": "grade-block-provider.schema.json#/properties/ratings/items"
          },
          "confidence": {
            "type": "number"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "interrupted",
        "failed"
      ]
    }
  }
}
