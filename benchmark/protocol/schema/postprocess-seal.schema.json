{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/postprocess-seal.schema.json",
  "title": "Append-only quality postprocess seal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "parentCoreSealSha256",
    "gradingInputManifestSha256",
    "tDoneQualityPhaseSha256",
    "tDryQualityPhaseSha256",
    "aiAdjudicationSha256",
    "humanAuditQueueSha256",
    "humanValidationStatus",
    "humanValidatedCompositeClaim",
    "reportSha256",
    "postprocessContent",
    "sealedAtUtc",
    "sealSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "parentCoreSealSha256": {
      "$ref": "#/$defs/sha256"
    },
    "gradingInputManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "tDoneQualityPhaseSha256": {
      "$ref": "#/$defs/sha256"
    },
    "tDryQualityPhaseSha256": {
      "$ref": "#/$defs/sha256"
    },
    "aiAdjudicationSha256": {
      "$ref": "#/$defs/sha256"
    },
    "humanAuditQueueSha256": {
      "$ref": "#/$defs/sha256"
    },
    "humanValidationStatus": {
      "const": "pending"
    },
    "humanValidatedCompositeClaim": {
      "const": false
    },
    "reportSha256": {
      "$ref": "#/$defs/sha256"
    },
    "postprocessContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "rawTree",
        "files",
        "fileSetSha256",
        "fileCount",
        "byteLength"
      ],
      "properties": {
        "root": {
          "const": "postprocess/content"
        },
        "rawTree": {
          "$ref": "#/$defs/rawTree"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "fileSetSha256": {
          "$ref": "#/$defs/sha256"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sealedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "sealSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "rawTree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithmId",
        "sha256"
      ],
      "properties": {
        "algorithmId": {
          "const": "sha256-posix-path-nul-bytes-v1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
