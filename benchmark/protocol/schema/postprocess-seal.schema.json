{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/postprocess-seal.schema.json",
  "title": "Append-only quality postprocess seal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "parentCoreSealSha256",
    "gradingInputManifestSha256",
    "tDoneQualityPhaseSha256",
    "tDryQualityPhaseSha256",
    "aiAdjudicationSha256",
    "humanAuditQueueSha256",
    "humanValidationStatus",
    "humanValidatedCompositeClaim",
    "reportSha256",
    "postprocessTreeSha256",
    "sealedAtUtc",
    "sealSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "parentCoreSealSha256": {
      "$ref": "#/$defs/sha256"
    },
    "gradingInputManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "tDoneQualityPhaseSha256": {
      "$ref": "#/$defs/sha256"
    },
    "tDryQualityPhaseSha256": {
      "$ref": "#/$defs/sha256"
    },
    "aiAdjudicationSha256": {
      "$ref": "#/$defs/sha256"
    },
    "humanAuditQueueSha256": {
      "$ref": "#/$defs/sha256"
    },
    "humanValidationStatus": {
      "const": "pending"
    },
    "humanValidatedCompositeClaim": {
      "const": false
    },
    "reportSha256": {
      "$ref": "#/$defs/sha256"
    },
    "postprocessTreeSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sealedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "sealSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
