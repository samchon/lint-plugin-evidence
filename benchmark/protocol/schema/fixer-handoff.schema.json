{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/fixer-handoff.schema.json",
  "title": "Immutable verified-only Phase 2 fixer handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "round",
    "handoffId",
    "createdAtUtc",
    "rawWorkspaceDigest",
    "neutralBundleSha256",
    "catalogSha256",
    "verifiedFindingSchemaSha256",
    "verifiedFindings",
    "manifestSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "handoffId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$"
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "rawWorkspaceDigest": {
      "$ref": "#/$defs/sha256"
    },
    "neutralBundleSha256": {
      "$ref": "#/$defs/sha256"
    },
    "catalogSha256": {
      "$ref": "#/$defs/sha256"
    },
    "verifiedFindingSchemaSha256": {
      "$ref": "#/$defs/sha256"
    },
    "verifiedFindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "verified-finding.schema.json"
      }
    },
    "manifestSha256": {
      "description": "SHA-256 of RFC 8785 canonical JSON for this manifest with manifestSha256 omitted.",
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
