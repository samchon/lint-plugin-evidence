{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/cost-predictions.schema.json",
  "title": "Frozen machine-readable cost predictions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "freezeId",
    "status",
    "activeLeaf",
    "sourceChain",
    "valueSelection",
    "zeroObservationProvenance",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "freezeId": {
      "const": "current-freeze-template-standard-v1"
    },
    "status": {
      "const": "prediction-not-observation"
    },
    "activeLeaf": {
      "$ref": "#/$defs/source"
    },
    "sourceChain": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/source"
          },
          {
            "type": "object",
            "required": [
              "order"
            ],
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        ]
      }
    },
    "valueSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantiles",
        "conditionality",
        "wallClock",
        "providerTokens",
        "monetary"
      ],
      "properties": {
        "quantiles": {
          "const": [
            "p50",
            "p90"
          ]
        },
        "conditionality": {
          "const": "conditional-on-reaching-milestone"
        },
        "wallClock": {
          "allOf": [
            {
              "$ref": "#/$defs/tableSelection"
            },
            {
              "type": "object",
              "properties": {
                "sourcePath": {
                  "const": "predictions/current-freeze-standard-tier.md"
                },
                "sourceSha256": {
                  "const": "963a3f8dfc6c91680384b3d0d38779a7c596504c77fca14830580f8d79f71fda"
                },
                "sectionHeading": {
                  "const": "## Revised Standard wall-clock prior"
                },
                "unit": {
                  "const": "hours"
                }
              }
            }
          ]
        },
        "providerTokens": {
          "allOf": [
            {
              "$ref": "#/$defs/tableSelection"
            },
            {
              "type": "object",
              "properties": {
                "sourcePath": {
                  "const": "predictions/current-freeze-all-subjects.md"
                },
                "sourceSha256": {
                  "const": "371ed9d85a0d305a36c4d88bd4727af35ddf1f41d045b0491401c2b1a61a15f0"
                },
                "sectionHeading": {
                  "const": "## Provider-token total prior"
                },
                "unit": {
                  "const": "millions-of-provider-total-tokens"
                }
              }
            }
          ]
        },
        "monetary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourcePath",
            "sourceSha256",
            "providerCredits",
            "usd",
            "assertionText"
          ],
          "properties": {
            "sourcePath": {
              "$ref": "#/$defs/sourcePath"
            },
            "sourceSha256": {
              "$ref": "#/$defs/sha256"
            },
            "providerCredits": {
              "const": "unavailable"
            },
            "usd": {
              "const": "unavailable"
            },
            "assertionText": {
              "const": "Provider credits and USD therefore remain literally unavailable, and the benchmark makes no cost-effectiveness claim."
            }
          }
        }
      }
    },
    "zeroObservationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationCount",
        "observedDataUsed",
        "assertionSourcePath",
        "assertionSourceSha256",
        "assertionText",
        "paidGenerationResultsUsed",
        "benchmarkTranscriptsUsed",
        "gradesUsed",
        "gateOutcomesUsed",
        "timeObservationsUsed",
        "tokenObservationsUsed",
        "qualityObservationsUsed",
        "coverageObservationsUsed"
      ],
      "properties": {
        "observationCount": {
          "const": 0
        },
        "observedDataUsed": {
          "const": false
        },
        "assertionSourcePath": {
          "$ref": "#/$defs/sourcePath"
        },
        "assertionSourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "assertionText": {
          "const": "No paid generation result, benchmark transcript, grade, gate outcome, time observation, token observation, quality observation, or coverage observation informed this addendum."
        },
        "paidGenerationResultsUsed": {
          "const": false
        },
        "benchmarkTranscriptsUsed": {
          "const": false
        },
        "gradesUsed": {
          "const": false
        },
        "gateOutcomesUsed": {
          "const": false
        },
        "timeObservationsUsed": {
          "const": false
        },
        "tokenObservationsUsed": {
          "const": false
        },
        "qualityObservationsUsed": {
          "const": false
        },
        "coverageObservationsUsed": {
          "const": false
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/row"
      },
      "allOf": [
        {
          "$ref": "#/$defs/todoEvidence"
        },
        {
          "$ref": "#/$defs/todoPlain"
        },
        {
          "$ref": "#/$defs/redditEvidence"
        },
        {
          "$ref": "#/$defs/redditPlain"
        },
        {
          "$ref": "#/$defs/shoppingEvidence"
        },
        {
          "$ref": "#/$defs/shoppingPlain"
        },
        {
          "$ref": "#/$defs/erpEvidence"
        },
        {
          "$ref": "#/$defs/erpPlain"
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourcePath": {
      "type": "string",
      "pattern": "^predictions/current-freeze-[a-z0-9-]+\\.md$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "reviewId"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/sourcePath"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewId": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tableSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "sourceSha256",
        "sectionHeading",
        "unit"
      ],
      "properties": {
        "sourcePath": {
          "$ref": "#/$defs/sourcePath"
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sectionHeading": {
          "enum": [
            "## Revised Standard wall-clock prior",
            "## Provider-token total prior"
          ]
        },
        "unit": {
          "enum": [
            "hours",
            "millions-of-provider-total-tokens"
          ]
        }
      }
    },
    "quantiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p50",
        "p90"
      ],
      "properties": {
        "p50": {
          "type": "integer",
          "minimum": 0
        },
        "p90": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nullableQuantiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p50",
        "p90"
      ],
      "properties": {
        "p50": {
          "const": null
        },
        "p90": {
          "const": null
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wallClockHours",
        "providerTokensMillions",
        "providerCredits",
        "monetaryStatus"
      ],
      "properties": {
        "wallClockHours": {
          "$ref": "#/$defs/quantiles"
        },
        "providerTokensMillions": {
          "$ref": "#/$defs/quantiles"
        },
        "providerCredits": {
          "$ref": "#/$defs/nullableQuantiles"
        },
        "monetaryStatus": {
          "const": "unavailable"
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "arm",
        "milestones"
      ],
      "properties": {
        "subject": {
          "enum": [
            "todo",
            "reddit",
            "shopping",
            "erp"
          ]
        },
        "arm": {
          "enum": [
            "evidence",
            "plain"
          ]
        },
        "milestones": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t_done",
            "t_dry"
          ],
          "properties": {
            "t_done": {
              "$ref": "#/$defs/milestone"
            },
            "t_dry": {
              "$ref": "#/$defs/milestone"
            }
          }
        }
      }
    },
    "todoEvidence": {
      "$ref": "#/$defs/containsTodoEvidence"
    },
    "todoPlain": {
      "$ref": "#/$defs/containsTodoPlain"
    },
    "redditEvidence": {
      "$ref": "#/$defs/containsRedditEvidence"
    },
    "redditPlain": {
      "$ref": "#/$defs/containsRedditPlain"
    },
    "shoppingEvidence": {
      "$ref": "#/$defs/containsShoppingEvidence"
    },
    "shoppingPlain": {
      "$ref": "#/$defs/containsShoppingPlain"
    },
    "erpEvidence": {
      "$ref": "#/$defs/containsErpEvidence"
    },
    "erpPlain": {
      "$ref": "#/$defs/containsErpPlain"
    },
    "containsTodoEvidence": {
      "$ref": "#/$defs/todoEvidenceRowCount"
    },
    "containsTodoPlain": {
      "$ref": "#/$defs/todoPlainRowCount"
    },
    "containsRedditEvidence": {
      "$ref": "#/$defs/redditEvidenceRowCount"
    },
    "containsRedditPlain": {
      "$ref": "#/$defs/redditPlainRowCount"
    },
    "containsShoppingEvidence": {
      "$ref": "#/$defs/shoppingEvidenceRowCount"
    },
    "containsShoppingPlain": {
      "$ref": "#/$defs/shoppingPlainRowCount"
    },
    "containsErpEvidence": {
      "$ref": "#/$defs/erpEvidenceRowCount"
    },
    "containsErpPlain": {
      "$ref": "#/$defs/erpPlainRowCount"
    },
    "todoEvidenceRowCount": {
      "type": "array",
      "contains": {
        "$ref": "#/$defs/todoEvidenceIdentity"
      },
      "minContains": 1,
      "maxContains": 1
    },
    "todoPlainRowCount": {
      "type": "array",
      "contains": {
        "$ref": "#/$defs/todoPlainIdentity"
      },
      "minContains": 1,
      "maxContains": 1
    },
    "redditEvidenceRowCount": {
      "type": "array",
      "contains": {
        "$ref": "#/$defs/redditEvidenceIdentity"
      },
      "minContains": 1,
      "maxContains": 1
    },
    "redditPlainRowCount": {
      "type": "array",
      "contains": {
        "$ref": "#/$defs/redditPlainIdentity"
      },
      "minContains": 1,
      "maxContains": 1
    },
    "shoppingEvidenceRowCount": {
      "type": "array",
      "contains": {
        "$ref": "#/$defs/shoppingEvidenceIdentity"
      },
      "minContains": 1,
      "maxContains": 1
    },
    "shoppingPlainRowCount": {
      "type": "array",
      "contains": {
        "$ref": "#/$defs/shoppingPlainIdentity"
      },
      "minContains": 1,
      "maxContains": 1
    },
    "erpEvidenceRowCount": {
      "type": "array",
      "contains": {
        "$ref": "#/$defs/erpEvidenceIdentity"
      },
      "minContains": 1,
      "maxContains": 1
    },
    "erpPlainRowCount": {
      "type": "array",
      "contains": {
        "$ref": "#/$defs/erpPlainIdentity"
      },
      "minContains": 1,
      "maxContains": 1
    },
    "todoEvidenceIdentity": {
      "$ref": "#/$defs/todoEvidenceIdentityObject"
    },
    "todoPlainIdentity": {
      "$ref": "#/$defs/todoPlainIdentityObject"
    },
    "redditEvidenceIdentity": {
      "$ref": "#/$defs/redditEvidenceIdentityObject"
    },
    "redditPlainIdentity": {
      "$ref": "#/$defs/redditPlainIdentityObject"
    },
    "shoppingEvidenceIdentity": {
      "$ref": "#/$defs/shoppingEvidenceIdentityObject"
    },
    "shoppingPlainIdentity": {
      "$ref": "#/$defs/shoppingPlainIdentityObject"
    },
    "erpEvidenceIdentity": {
      "$ref": "#/$defs/erpEvidenceIdentityObject"
    },
    "erpPlainIdentity": {
      "$ref": "#/$defs/erpPlainIdentityObject"
    },
    "todoEvidenceIdentityObject": {
      "type": "object",
      "required": [
        "subject",
        "arm"
      ],
      "properties": {
        "subject": {
          "const": "todo"
        },
        "arm": {
          "const": "evidence"
        }
      }
    },
    "todoPlainIdentityObject": {
      "type": "object",
      "required": [
        "subject",
        "arm"
      ],
      "properties": {
        "subject": {
          "const": "todo"
        },
        "arm": {
          "const": "plain"
        }
      }
    },
    "redditEvidenceIdentityObject": {
      "type": "object",
      "required": [
        "subject",
        "arm"
      ],
      "properties": {
        "subject": {
          "const": "reddit"
        },
        "arm": {
          "const": "evidence"
        }
      }
    },
    "redditPlainIdentityObject": {
      "type": "object",
      "required": [
        "subject",
        "arm"
      ],
      "properties": {
        "subject": {
          "const": "reddit"
        },
        "arm": {
          "const": "plain"
        }
      }
    },
    "shoppingEvidenceIdentityObject": {
      "type": "object",
      "required": [
        "subject",
        "arm"
      ],
      "properties": {
        "subject": {
          "const": "shopping"
        },
        "arm": {
          "const": "evidence"
        }
      }
    },
    "shoppingPlainIdentityObject": {
      "type": "object",
      "required": [
        "subject",
        "arm"
      ],
      "properties": {
        "subject": {
          "const": "shopping"
        },
        "arm": {
          "const": "plain"
        }
      }
    },
    "erpEvidenceIdentityObject": {
      "type": "object",
      "required": [
        "subject",
        "arm"
      ],
      "properties": {
        "subject": {
          "const": "erp"
        },
        "arm": {
          "const": "evidence"
        }
      }
    },
    "erpPlainIdentityObject": {
      "type": "object",
      "required": [
        "subject",
        "arm"
      ],
      "properties": {
        "subject": {
          "const": "erp"
        },
        "arm": {
          "const": "plain"
        }
      }
    }
  }
}
