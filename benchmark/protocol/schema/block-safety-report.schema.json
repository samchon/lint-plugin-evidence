{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/block-safety-report.schema.json",
  "title": "Append-only outer block token-safety report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "blockId",
    "blockPlanSha256",
    "maximumObservedBlockTotalTokens",
    "observedBlockTotalTokens",
    "blockObservedOvershootTokens",
    "deduplicatedResponseIds",
    "cellCostReports",
    "thresholdReached",
    "hardCeilingGuaranteed",
    "blockObservedStopTriggered",
    "blockStartedAtUtc",
    "blockStartedMonotonicNanoseconds",
    "blockHardWallDurationSeconds",
    "blockHardDeadlineUtc",
    "blockHardDeadlineReached",
    "blockWallClockStopTriggered",
    "globalAbortId",
    "sharedStopEventSha256",
    "allCellsQuiesced",
    "allProcessTreesTerminated",
    "usageLowerBound",
    "rightCensored",
    "monetaryStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "blockId": {
      "type": "string",
      "minLength": 1
    },
    "blockPlanSha256": {
      "$ref": "#/$defs/sha256"
    },
    "maximumObservedBlockTotalTokens": {
      "type": "integer",
      "minimum": 1
    },
    "observedBlockTotalTokens": {
      "type": "integer",
      "minimum": 0
    },
    "blockObservedOvershootTokens": {
      "type": "integer",
      "minimum": 0
    },
    "deduplicatedResponseIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cellCostReports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runId",
          "costReportSha256",
          "coreSealSha256"
        ],
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1
          },
          "costReportSha256": {
            "$ref": "#/$defs/sha256"
          },
          "coreSealSha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "thresholdReached": {
      "type": "boolean"
    },
    "hardCeilingGuaranteed": {
      "const": false
    },
    "blockObservedStopTriggered": {
      "type": "boolean"
    },
    "blockStartedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "blockStartedMonotonicNanoseconds": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "blockHardWallDurationSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "blockHardDeadlineUtc": {
      "type": "string",
      "format": "date-time"
    },
    "blockHardDeadlineReached": {
      "type": "boolean"
    },
    "blockWallClockStopTriggered": {
      "type": "boolean"
    },
    "globalAbortId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sharedStopEventSha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "allCellsQuiesced": {
      "type": "boolean"
    },
    "allProcessTreesTerminated": {
      "type": "boolean"
    },
    "usageLowerBound": {
      "type": "boolean"
    },
    "rightCensored": {
      "type": "boolean"
    },
    "monetaryStatus": {
      "const": "unavailable"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
