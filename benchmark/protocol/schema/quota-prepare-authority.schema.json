{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/quota-prepare-authority.schema.json",
  "title": "Prepare-time quota authority admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "blockId",
    "subjects",
    "authorization"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "blockId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$"
    },
    "subjects": {
      "$ref": "block-plan.schema.json#/$defs/subjectWave"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quotaState",
        "quotaAuthorityBoundary"
      ],
      "properties": {
        "quotaState": {
          "$ref": "block-plan.schema.json#/properties/authorization/properties/quotaState"
        },
        "quotaAuthorityBoundary": {
          "$ref": "block-plan.schema.json#/properties/authorization/properties/quotaAuthorityBoundary"
        }
      }
    }
  }
}
