{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/campaign-state.schema.json",
  "title": "Resumable Phase 2 campaign state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "phase1Boundary",
    "firstDoneThreadId",
    "finderPromptSha256",
    "verifierPromptSha256",
    "fixerPromptSha256",
    "requiredCleanRounds",
    "consecutiveCleanRounds",
    "findingHistory",
    "canonicalFindingIdRegistry",
    "activeDedupeIndex",
    "findingLifecycles",
    "findingClosures",
    "rounds",
    "updatedAtUtc",
    "startedAtUtc",
    "deadlineAtUtc"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "running",
        "interrupted",
        "failed",
        "completed"
      ]
    },
    "phase1Boundary": {
      "$ref": "campaign-round.schema.json#/$defs/phase1Boundary"
    },
    "firstDoneThreadId": {
      "type": "string",
      "minLength": 1
    },
    "finderPromptSha256": {
      "$ref": "#/$defs/sha256"
    },
    "verifierPromptSha256": {
      "$ref": "#/$defs/sha256"
    },
    "fixerPromptSha256": {
      "$ref": "#/$defs/sha256"
    },
    "requiredCleanRounds": {
      "const": 2
    },
    "consecutiveCleanRounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "cleanDigest": {
      "$ref": "#/$defs/sha256"
    },
    "findingHistory": {
      "type": "array",
      "items": {
        "$ref": "campaign-round.schema.json#/$defs/dedupe"
      }
    },
    "canonicalFindingIdRegistry": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "activeDedupeIndex": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authoredDigest",
            "entries"
          ],
          "properties": {
            "authoredDigest": {
              "$ref": "#/$defs/sha256"
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "campaign-round.schema.json#/$defs/dedupe"
              }
            }
          }
        }
      ]
    },
    "findingLifecycles": {
      "type": "array",
      "items": {
        "$ref": "campaign-round.schema.json#/$defs/findingLifecycle"
      }
    },
    "findingClosures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/findingClosure"
      }
    },
    "rounds": {
      "type": "array",
      "items": {
        "$ref": "campaign-round.schema.json"
      }
    },
    "incompleteRound": {
      "$ref": "#/$defs/incompleteRound"
    },
    "tDryEventSha256": {
      "$ref": "#/$defs/sha256"
    },
    "tDryAuthoredDigest": {
      "$ref": "#/$defs/sha256"
    },
    "updatedAtUtc": {
      "$ref": "#/$defs/dateTime"
    },
    "startedAtUtc": {
      "$ref": "#/$defs/dateTime"
    },
    "deadlineAtUtc": {
      "$ref": "#/$defs/dateTime"
    },
    "terminalReason": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "incompleteRound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "startedAtUtc",
        "stage",
        "finders",
        "dedupeDecisions",
        "verifications",
        "reason"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "startedAtUtc": {
          "$ref": "#/$defs/dateTime"
        },
        "stage": {
          "enum": [
            "bundle",
            "finder",
            "dedupe",
            "verifier",
            "mutation-check",
            "fixer",
            "fix-resolution",
            "gate"
          ]
        },
        "bundle": {
          "$ref": "campaign-round.schema.json#/$defs/bundle"
        },
        "finders": {
          "type": "array",
          "items": {
            "$ref": "campaign-round.schema.json#/$defs/finder"
          }
        },
        "dedupeDecisions": {
          "type": "array",
          "items": {
            "$ref": "campaign-round.schema.json#/$defs/dedupe"
          }
        },
        "verifications": {
          "type": "array",
          "items": {
            "$ref": "campaign-round.schema.json#/$defs/verification"
          }
        },
        "mutationCheck": {
          "$ref": "campaign-round.schema.json#/$defs/mutation"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "findingClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "canonicalFindingId",
        "from",
        "to",
        "authoredDigest",
        "manifestSha256",
        "resolution"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "canonicalFindingId": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "const": "repair_pending"
        },
        "to": {
          "const": "fixed"
        },
        "authoredDigest": {
          "$ref": "#/$defs/sha256"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalFindingId",
        "source",
        "verdict",
        "freshVerifierThreadId",
        "responseIds",
        "reproduction",
        "mutationReplay"
      ],
      "properties": {
        "canonicalFindingId": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "finder_verification",
            "harness_mutation"
          ]
        },
        "verdict": {
          "enum": [
            "fixed",
            "still_present",
            "unverifiable"
          ]
        },
        "freshVerifierThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "responseIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reproduction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "exitCode",
            "evidenceSha256",
            "expectedResolution",
            "matched"
          ],
          "properties": {
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "exitCode": {
              "type": [
                "integer",
                "null"
              ]
            },
            "evidenceSha256": {
              "$ref": "#/$defs/sha256"
            },
            "expectedResolution": {
              "type": "string",
              "minLength": 1
            },
            "matched": {
              "type": "boolean"
            }
          }
        },
        "mutationReplay": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sameTargetId",
                "expectedFailureMatched",
                "restoreSha256",
                "restoredBytesExact"
              ],
              "properties": {
                "sameTargetId": {
                  "const": true
                },
                "expectedFailureMatched": {
                  "const": true
                },
                "restoreSha256": {
                  "$ref": "#/$defs/sha256"
                },
                "restoredBytesExact": {
                  "const": true
                }
              }
            }
          ]
        }
      }
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
