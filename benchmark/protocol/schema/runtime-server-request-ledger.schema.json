{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/runtime-server-request-ledger.schema.json",
  "title": "Runner-side generated API request ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "instanceId",
    "leaseId",
    "runId",
    "subject",
    "arm",
    "milestone",
    "sessionId",
    "nonce",
    "requests"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "instanceId": { "type": "string", "minLength": 1 },
    "leaseId": { "type": "string", "format": "uuid" },
    "runId": { "type": "string", "minLength": 1 },
    "subject": { "enum": ["todo", "reddit", "shopping", "erp"] },
    "arm": { "enum": ["evidence", "plain"] },
    "milestone": { "enum": ["t_done", "t_dry"] },
    "sessionId": { "type": "string", "format": "uuid" },
    "nonce": { "$ref": "#/$defs/nonce" },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/request" }
    }
  },
  "$defs": {
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "nonce", "method", "path", "status"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "nonce": { "$ref": "#/$defs/nonce" },
        "method": { "type": "string", "pattern": "^[A-Z]+$" },
        "path": { "type": "string", "pattern": "^/(?!/).*$" },
        "status": { "type": "integer", "minimum": 100, "maximum": 599 }
      }
    }
  }
}
