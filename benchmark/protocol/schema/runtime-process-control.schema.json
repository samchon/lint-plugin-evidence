{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/runtime-process-control.schema.json",
  "title": "Private runner process and toolchain control evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "instanceId",
    "leaseId",
    "runId",
    "subject",
    "arm",
    "milestone",
    "requestedProcesses",
    "effectiveEnvironment",
    "toolchain"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "instanceId": { "type": "string", "minLength": 1 },
    "leaseId": { "type": "string", "format": "uuid" },
    "runId": { "type": "string", "minLength": 1 },
    "subject": { "enum": ["todo", "reddit", "shopping", "erp"] },
    "arm": { "enum": ["evidence", "plain"] },
    "milestone": { "enum": ["t_done", "t_dry"] },
    "requestedProcesses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/process" }
    },
    "effectiveEnvironment": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "API_PORT",
          "APPDATA",
          "CI",
          "COMSPEC",
          "GOCACHE",
          "GOTMPDIR",
          "HOME",
          "LOCALAPPDATA",
          "NO_COLOR",
          "npm_config_store_dir",
          "PATH",
          "PATHEXT",
          "SHELL",
          "SystemRoot",
          "TEMP",
          "TMP",
          "TMPDIR",
          "TTSC_CACHE_DIR",
          "TTSC_GO_CACHE_DIR",
          "USERPROFILE",
          "VITE_API_HOST",
          "VITE_API_SIMULATE"
        ]
      },
      "additionalProperties": { "type": "string" }
    },
    "toolchain": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/toolchain" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "command", "arguments"],
      "properties": {
        "role": { "enum": ["api", "frontend"] },
        "command": { "type": "string", "minLength": 1 },
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "requested", "realpath", "sha256", "version"],
      "properties": {
        "role": {
          "enum": ["node", "corepack_launcher", "corepack_entrypoint"]
        },
        "requested": { "type": "string", "minLength": 1 },
        "realpath": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
