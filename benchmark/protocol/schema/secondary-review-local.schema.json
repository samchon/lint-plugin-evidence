{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/secondary-review-local.schema.json",
  "title": "Local blind UI and maintainability review",
  "allOf": [
    {
      "$ref": "secondary-review-provider.schema.json"
    },
    {
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "role": {
          "const": "blind_secondary_review"
        },
        "reviewId": {
          "minLength": 1
        },
        "bundleId": {
          "minLength": 1
        },
        "graderPseudonym": {
          "minLength": 1
        },
        "visualEvidenceSha256": {
          "pattern": "^[a-f0-9]{64}$"
        },
        "ratings": {
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "properties": {
              "confidence": {
                "minimum": 0,
                "maximum": 1
              },
              "rationale": {
                "minLength": 1
              }
            }
          }
        },
        "rationale": {
          "minLength": 1
        }
      }
    }
  ]
}
