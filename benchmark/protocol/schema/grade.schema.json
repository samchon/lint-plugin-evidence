{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/grade.schema.json",
  "title": "Blind semantic grade",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gradeId",
    "bundleId",
    "subject",
    "phase",
    "grader",
    "blind",
    "gradingPlanSha256",
    "parentCoreSealSha256",
    "rubricSha256",
    "gradeBlockProviderSchemaSha256",
    "gradeBlockLocalSchemaSha256",
    "providerOutputRegistrySha256",
    "sourceResponseIds",
    "sourceResponseIdsSha256",
    "acceptanceCatalogSha256",
    "acceptancePopulationCount",
    "contextCatalogSha256",
    "contextPopulationCount",
    "acceptanceRatings",
    "contextRatings",
    "acceptanceSummary",
    "contextSummary",
    "denominatorsSummed",
    "populationValidation",
    "submittedAtUtc"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "gradeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$"
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{5,127}$"
    },
    "subject": {
      "enum": [
        "todo",
        "reddit",
        "shopping",
        "erp"
      ]
    },
    "phase": {
      "enum": [
        "t_done",
        "t_dry"
      ]
    },
    "grader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pseudonym",
        "kind",
        "model",
        "version"
      ],
      "properties": {
        "pseudonym": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "llm",
            "human",
            "human_adjudicator"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "blind": {
      "const": true
    },
    "gradingPlanSha256": {
      "$ref": "#/$defs/sha256"
    },
    "parentCoreSealSha256": {
      "$ref": "#/$defs/sha256"
    },
    "rubricSha256": {
      "$ref": "#/$defs/sha256"
    },
    "gradeBlockProviderSchemaSha256": {
      "$ref": "#/$defs/sha256"
    },
    "gradeBlockLocalSchemaSha256": {
      "$ref": "#/$defs/sha256"
    },
    "providerOutputRegistrySha256": {
      "$ref": "#/$defs/sha256"
    },
    "sourceResponseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceResponseIdsSha256": {
      "$ref": "#/$defs/sha256"
    },
    "acceptanceCatalogSha256": {
      "$ref": "#/$defs/sha256"
    },
    "acceptancePopulationCount": {
      "type": "integer",
      "minimum": 1
    },
    "contextCatalogSha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "contextPopulationCount": {
      "type": "integer",
      "minimum": 0
    },
    "acceptanceRatings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/acceptanceRating"
      }
    },
    "contextRatings": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contextRating"
          }
        }
      ]
    },
    "acceptanceSummary": {
      "$ref": "#/$defs/summary"
    },
    "contextSummary": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/summary"
        }
      ]
    },
    "denominatorsSummed": {
      "const": false
    },
    "populationValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactCatalogIdSets",
        "uniqueCriterionIds",
        "populationCountsExact",
        "summariesReconciled",
        "crossPopulationReferences"
      ],
      "properties": {
        "exactCatalogIdSets": {
          "const": true
        },
        "uniqueCriterionIds": {
          "const": true
        },
        "populationCountsExact": {
          "const": true
        },
        "summariesReconciled": {
          "const": true
        },
        "crossPopulationReferences": {
          "const": 0
        }
      }
    },
    "submittedAtUtc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contextCatalogSha256": {
            "type": "null"
          }
        },
        "required": [
          "contextCatalogSha256"
        ]
      },
      "then": {
        "properties": {
          "contextRatings": {
            "type": "null"
          },
          "contextSummary": {
            "type": "null"
          },
          "contextPopulationCount": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "contextRatings": {
            "type": "array",
            "minItems": 1
          },
          "contextSummary": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject": {
            "const": "erp"
          }
        },
        "required": [
          "subject"
        ]
      },
      "then": {
        "properties": {
          "acceptancePopulationCount": {
            "const": 1724
          },
          "contextPopulationCount": {
            "const": 986
          },
          "contextCatalogSha256": {
            "$ref": "#/$defs/sha256"
          },
          "contextRatings": {
            "type": "array",
            "minItems": 986,
            "maxItems": 986
          },
          "acceptanceRatings": {
            "type": "array",
            "minItems": 1724,
            "maxItems": 1724
          },
          "contextSummary": {
            "type": "object"
          },
          "denominatorsSummed": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "populationCount",
        "applicable",
        "implementedCorrectly",
        "partial",
        "omitted",
        "contradicted",
        "unverifiable",
        "notApplicable",
        "testable",
        "nonVacuousTested",
        "criticalDefects"
      ],
      "properties": {
        "populationCount": {
          "type": "integer",
          "minimum": 1
        },
        "applicable": {
          "type": "integer",
          "minimum": 0
        },
        "implementedCorrectly": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "minimum": 0
        },
        "contradicted": {
          "type": "integer",
          "minimum": 0
        },
        "unverifiable": {
          "type": "integer",
          "minimum": 0
        },
        "notApplicable": {
          "type": "integer",
          "minimum": 0
        },
        "testable": {
          "type": "integer",
          "minimum": 0
        },
        "nonVacuousTested": {
          "type": "integer",
          "minimum": 0
        },
        "criticalDefects": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "acceptanceRating": {
      "$ref": "#/$defs/rating"
    },
    "contextRating": {
      "$ref": "#/$defs/rating"
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterionId",
        "status",
        "confidence",
        "surfaces",
        "test",
        "evidence",
        "defectClass",
        "severity",
        "rationale"
      ],
      "properties": {
        "criterionId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "implemented_correctly",
            "partial",
            "omitted",
            "contradicted",
            "unverifiable",
            "not_applicable"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "surfaces": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surface",
              "status"
            ],
            "properties": {
              "surface": {
                "enum": [
                  "database",
                  "api",
                  "backend",
                  "frontend",
                  "integration",
                  "test",
                  "operations",
                  "documentation"
                ]
              },
              "status": {
                "enum": [
                  "correct",
                  "partial",
                  "missing",
                  "wrong",
                  "not_applicable"
                ]
              }
            }
          }
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "testable",
            "exists",
            "executed",
            "passes",
            "nonVacuous",
            "positive",
            "negative",
            "boundary",
            "counterfactual"
          ],
          "properties": {
            "testable": {
              "type": "boolean"
            },
            "exists": {
              "type": "boolean"
            },
            "executed": {
              "type": "boolean"
            },
            "passes": {
              "type": "boolean"
            },
            "nonVacuous": {
              "type": "boolean"
            },
            "positive": {
              "type": "boolean"
            },
            "negative": {
              "type": "boolean"
            },
            "boundary": {
              "type": "boolean"
            },
            "counterfactual": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line",
              "observation"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "observation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "defectClass": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "unacknowledged_in_denominator",
                "configuration_coverage",
                "false_acknowledgement",
                "partial_implementation",
                "semantic_defect",
                "test_oracle_gap",
                "non_defect"
              ]
            }
          ]
        },
        "severity": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
