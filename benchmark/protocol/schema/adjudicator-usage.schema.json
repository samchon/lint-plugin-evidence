{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/adjudicator-usage.schema.json",
  "title": "Fresh adjudicator exact usage projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "threadId",
    "sourceUsageReportPath",
    "sourceUsageReportSha256",
    "responseIds",
    "duplicateResponseIds",
    "inputTokens",
    "cachedInputTokens",
    "cacheWriteInputTokens",
    "outputTokens",
    "reasoningOutputTokens",
    "totalTokens",
    "exactUsageComplete",
    "exact"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "threadId": {
      "type": "string",
      "minLength": 1
    },
    "sourceUsageReportPath": {
      "const": "usage.json"
    },
    "sourceUsageReportSha256": {
      "$ref": "#/$defs/sha256"
    },
    "responseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "duplicateResponseIds": {
      "type": "array",
      "maxItems": 0
    },
    "inputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "cachedInputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "cacheWriteInputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "outputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "reasoningOutputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "totalTokens": {
      "type": "integer",
      "minimum": 0
    },
    "exactUsageComplete": {
      "const": true
    },
    "exact": {
      "const": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
