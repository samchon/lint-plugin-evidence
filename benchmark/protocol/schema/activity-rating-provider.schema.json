{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/activity-rating-provider.schema.json",
  "title": "Provider-facing response activity attribution block",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "role",
    "runId",
    "blockId",
    "responseIds",
    "ratings",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "activity_rater"
      ]
    },
    "runId": {
      "type": "string"
    },
    "blockId": {
      "type": "string"
    },
    "responseIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ratings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "responseId",
          "probabilityBasisPoints",
          "secondaryMechanisms",
          "causalRole",
          "confidence",
          "rationale"
        ],
        "properties": {
          "responseId": {
            "type": "string"
          },
          "probabilityBasisPoints": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirements_reading",
              "method_reading",
              "planning_inventory",
              "implementation",
              "deterministic_feedback",
              "ordinary_remediation",
              "completion_audit",
              "phase2_discovery",
              "phase2_fix",
              "grading",
              "residual_unclassified"
            ],
            "properties": {
              "requirements_reading": {
                "type": "integer"
              },
              "method_reading": {
                "type": "integer"
              },
              "planning_inventory": {
                "type": "integer"
              },
              "implementation": {
                "type": "integer"
              },
              "deterministic_feedback": {
                "type": "integer"
              },
              "ordinary_remediation": {
                "type": "integer"
              },
              "completion_audit": {
                "type": "integer"
              },
              "phase2_discovery": {
                "type": "integer"
              },
              "phase2_fix": {
                "type": "integer"
              },
              "grading": {
                "type": "integer"
              },
              "residual_unclassified": {
                "type": "integer"
              }
            }
          },
          "secondaryMechanisms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "direct_method_campaign",
                "induced_method_campaign",
                "quality_producing_fix",
                "shared_product_work"
              ]
            }
          },
          "causalRole": {
            "type": "string",
            "enum": [
              "shared",
              "direct_method_burden",
              "induced_method_burden",
              "quality_producing_fix",
              "residual"
            ]
          },
          "confidence": {
            "type": "number"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "interrupted",
        "failed"
      ]
    }
  }
}
