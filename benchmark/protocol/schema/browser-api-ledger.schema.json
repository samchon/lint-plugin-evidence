{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/browser-api-ledger.schema.json",
  "title": "Browser-observed leased API request ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiOrigin", "requests"],
  "properties": {
    "apiOrigin": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:[1-9][0-9]{0,4}$"
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "path", "status", "nonce"],
        "properties": {
          "method": {
            "type": "string",
            "pattern": "^[A-Z]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^/(?!/).*$"
          },
          "status": {
            "type": "integer",
            "minimum": 200,
            "maximum": 499
          },
          "nonce": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
