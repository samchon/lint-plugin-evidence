{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/verified-finding.schema.json",
  "title": "Canonical verified finding admitted to repair",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidateId",
    "fingerprint",
    "canonicalFindingId",
    "verdict",
    "classification",
    "severity",
    "lens",
    "atomicClauseIds",
    "locations",
    "expectedBehavior",
    "observedBehavior",
    "verificationProcedure",
    "verifierThreadId",
    "rationale",
    "evidence",
    "source"
  ],
  "properties": {
    "candidateId": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "canonicalFindingId": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "const": "verified"
    },
    "classification": {
      "enum": [
        "requirement_omission",
        "partial_implementation",
        "semantic_defect",
        "false_acknowledgement",
        "configuration_coverage",
        "test_oracle_gap"
      ]
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "lens": {
      "enum": [
        "requirements",
        "database",
        "api",
        "logic",
        "tests",
        "frontend"
      ]
    },
    "atomicClauseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expectedBehavior": {
      "type": "string",
      "minLength": 1
    },
    "observedBehavior": {
      "type": "string",
      "minLength": 1
    },
    "verificationProcedure": {
      "type": "string",
      "minLength": 1
    },
    "verifierThreadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "enum": [
        "finder_verification",
        "harness_mutation"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "finder_verification"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "verifierThreadId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "classification": {
            "const": "test_oracle_gap"
          },
          "verifierThreadId": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
