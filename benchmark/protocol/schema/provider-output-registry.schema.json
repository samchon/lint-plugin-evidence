{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samchon/lint-plugin-evidence/benchmark/protocol/schema/provider-output-registry.schema.json",
  "title": "Exhaustive registry of model-facing output schemas",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerKeywordAllowlist",
    "contracts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "providerKeywordAllowlist": {
      "const": [
        "$schema",
        "$id",
        "title",
        "type",
        "additionalProperties",
        "required",
        "properties",
        "enum",
        "items"
      ]
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "turns",
          "providerSchema",
          "localSchema"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "turns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "phase1-generation",
                "phase1-completion-challenge",
                "phase2-finder",
                "phase2-verifier"
              ]
            }
          },
          "providerSchema": {
            "type": "string",
            "pattern": "^schema/[a-z0-9-]+-provider\\.schema\\.json$"
          },
          "localSchema": {
            "type": "string",
            "pattern": "^schema/[a-z0-9-]+-local\\.schema\\.json$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "contracts": {
          "contains": {
            "properties": {
              "turns": {
                "contains": {
                  "const": "phase1-generation"
                }
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "contracts": {
          "contains": {
            "properties": {
              "turns": {
                "contains": {
                  "const": "phase1-completion-challenge"
                }
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "contracts": {
          "contains": {
            "properties": {
              "turns": {
                "contains": {
                  "const": "phase2-finder"
                }
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "contracts": {
          "contains": {
            "properties": {
              "turns": {
                "contains": {
                  "const": "phase2-verifier"
                }
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    }
  ]
}
