{
  "schemaVersion": 1,
  "policyId": "chatgpt-native-first-hit-v1",
  "sourceClass": "chatgpt-native-rate-limit",
  "guardRelation": "independent-first-hit-or",
  "thresholdClass": "provider-native-reached-or-spend-control",
  "authorizationCondition": "all-applicable-windows-pass",
  "windowClasses": {
    "primary": {
      "nullableOnFullSnapshot": true,
      "nativeReachedStops": true
    },
    "secondary": {
      "nullableOnFullSnapshot": true,
      "nativeReachedStops": true
    },
    "individual": {
      "nullableOnFullSnapshot": true,
      "nativeReachedStops": true
    },
    "spendControl": {
      "nullableOnFullSnapshot": true,
      "nativeReachedStops": true
    }
  },
  "sparseUpdatePolicy": {
    "initialFullReadRequired": true,
    "omittedWindowOnUpdate": "refetch-full-snapshot-before-decision",
    "unavailableFullRead": "fail-closed",
    "nullWindowOnFullSnapshot": "not_applicable"
  },
  "resetSemantics": "observational-only-never-derive-token-allowance",
  "numericConversion": "forbidden",
  "privateCheckpoint": {
    "persistence": "memory-only-until-attestation",
    "promoted": false,
    "destroyAfterAttestation": true
  },
  "authorityRequest": {
    "requestIdEncoding": "lowercase-hex-256-bit-random-nonce",
    "digestAlgorithmId": "sha256-rfc8785-controller-quota-request-v1",
    "canonicalization": "RFC8785",
    "implementationScope": "rfc8785-equivalent-closed-ascii-projection-v1",
    "projectionFields": [
      "authorityRequestId",
      "phase",
      "blockId",
      "planSha256",
      "subjects"
    ],
    "preparePlanSha256": null,
    "startPlanSha256": "exact-closed-block-plan-sha256"
  },
  "sanitizedAttestation": {
    "algorithmId": "sha256-rfc8785-sanitized-quota-attestation-v1",
    "canonicalization": "RFC8785",
    "implementationScope": "rfc8785-equivalent-closed-ascii-projection-v1",
    "projectionFields": [
      "authorityRequestId",
      "authorityRequestSha256",
      "phase",
      "blockId",
      "planSha256",
      "subjects",
      "sourceClass",
      "windowResults",
      "passedAtAuthorization",
      "policyId",
      "policyPath",
      "policySha256",
      "capturedAtUtc",
      "attestationAlgorithmId",
      "privateCheckpointPersistence",
      "exactTelemetryPromoted",
      "guardRelation"
    ],
    "rawTelemetryFieldsForbidden": true
  }
}
