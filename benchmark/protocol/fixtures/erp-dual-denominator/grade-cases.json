{
  "schemaVersion": 1,
  "subject": "erp",
  "acceptanceCatalog": "benchmark/requirements/erp/acceptance-criteria.jsonl",
  "acceptanceCount": 1724,
  "contextCatalog": "benchmark/requirements/erp/context-criteria.jsonl",
  "contextCount": 986,
  "baseFixture": "Build one complete grade from every exact catalog ID and reconcile each status summary independently.",
  "cases": [
    {
      "id": "valid-exact-populations",
      "mutation": "none",
      "expectedValid": true,
      "expectedCode": null
    },
    {
      "id": "missing-acceptance-id",
      "mutation": "remove one acceptance rating without changing the catalog",
      "expectedValid": false,
      "expectedCode": "acceptance_catalog_set_mismatch"
    },
    {
      "id": "missing-context-id",
      "mutation": "remove one context rating without changing the catalog",
      "expectedValid": false,
      "expectedCode": "context_catalog_set_mismatch"
    },
    {
      "id": "duplicate-acceptance-id",
      "mutation": "replace one acceptance rating ID with another acceptance ID already present",
      "expectedValid": false,
      "expectedCode": "duplicate_acceptance_id"
    },
    {
      "id": "duplicate-context-id",
      "mutation": "replace one context rating ID with another context ID already present",
      "expectedValid": false,
      "expectedCode": "duplicate_context_id"
    },
    {
      "id": "cross-population-acceptance",
      "mutation": "replace one acceptance rating ID with a context catalog ID",
      "expectedValid": false,
      "expectedCode": "cross_population_reference"
    },
    {
      "id": "cross-population-context",
      "mutation": "replace one context rating ID with an acceptance catalog ID",
      "expectedValid": false,
      "expectedCode": "cross_population_reference"
    },
    {
      "id": "short-acceptance-array",
      "mutation": "retain exactly 1723 acceptance ratings",
      "expectedValid": false,
      "expectedCode": "acceptance_population_count"
    },
    {
      "id": "short-context-array",
      "mutation": "retain exactly 985 context ratings",
      "expectedValid": false,
      "expectedCode": "context_population_count"
    },
    {
      "id": "context-added-to-acceptance-numerator",
      "mutation": "add one context implemented-correctly count to the acceptance summary without changing acceptance ratings",
      "expectedValid": false,
      "expectedCode": "acceptance_summary_reconciliation"
    },
    {
      "id": "combined-denominator",
      "mutation": "set denominatorsSummed true and report 2710 as one population",
      "expectedValid": false,
      "expectedCode": "combined_denominator_forbidden"
    }
  ]
}
