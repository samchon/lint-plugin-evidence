{
  "private": true,
  "name": "{{frontendPackageName}}",
  "version": "0.1.0",
  "description": "React and Vite frontend for {{name}}",
  "scripts": {
    "build": "rimraf dist && pnpm lint && vite build",
    "dev": "vite --host 0.0.0.0",
    "format": "ttsc format -p tsconfig.json",
    "lint": "ttsc -p tsconfig.json --noEmit",
    "playwright:install": "playwright install chromium",
    "preview": "vite preview --host 0.0.0.0",
    "readme:screens": "node scripts/run-playwright.mjs readme",
    "test": "pnpm test:e2e",
    "test:e2e": "node scripts/run-playwright.mjs e2e",
    "ui:review": "node scripts/run-playwright.mjs ui-review"
  },
  "dependencies": {
    "@nestia/fetcher": "catalog:backend",
    "@tanstack/react-query": "catalog:frontend",
    "{{apiPackageName}}": "workspace:*",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "react-router-dom": "catalog:frontend",
    "sonner": "catalog:frontend",
    "typia": "catalog:typescript"
  },
  "devDependencies": {
    "@playwright/test": "catalog:frontend",
    "@ttsc/lint": "catalog:typescript",
    "@ttsc/unplugin": "catalog:typescript",
    "@types/node": "catalog:backend",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "@vitejs/plugin-react": "catalog:frontend",
    "rimraf": "catalog:typescript",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript",
    "vite": "catalog:frontend"
  }
}
