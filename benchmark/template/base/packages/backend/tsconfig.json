{
  "extends": "../../config/tsconfig.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "..",
    "declaration": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "plugins": [
      {
        "transform": "@ttsc/lint",
        "configFile": "./lint.config.ts"
      }
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../api/src/structures/**/*.ts"
  ]
}
