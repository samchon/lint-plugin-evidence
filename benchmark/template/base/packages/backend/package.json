{
  "private": true,
  "name": "{{backendPackageName}}",
  "version": "0.1.0",
  "description": "NestJS, Nestia, and Prisma backend for {{name}}",
  "scripts": {
    "build": "pnpm build:prisma && pnpm --dir ../api build && pnpm build:main && pnpm build:sdk && pnpm build:test",
    "build:main": "rimraf lib && ttsc -p tsconfig.json",
    "build:prisma": "prisma generate --schema=prisma/schema",
    "build:sdk": "rimraf ../api/src/functional ../api/src/HttpError.ts ../api/src/IConnection.ts ../api/src/Primitive.ts ../api/src/Resolved.ts ../api/src/module.ts ../api/swagger.json && nestia all && node ../api/scripts/ensure-nestia-exports.cjs && pnpm --dir ../api build",
    "build:test": "rimraf bin && ttsc -p test/tsconfig.json",
    "dev": "ttsx src/executable/server.ts",
    "format": "ttsc format -p tsconfig.json && ttsc format -p test/tsconfig.json",
    "lint": "ttsc -p tsconfig.lint.json --noEmit",
    "prepare": "prisma db push --schema=prisma/schema",
    "start": "ttsx src/executable/server.ts",
    "start:prod": "node lib/executable/server.js",
    "start:swagger": "ttsx src/executable/swagger.ts",
    "test": "ttsx --project test/tsconfig.json test/index.ts"
  },
  "dependencies": {
    "@nestia/core": "catalog:samchon",
    "@nestia/fetcher": "catalog:samchon",
    "@nestjs/common": "catalog:backend",
    "@nestjs/core": "catalog:backend",
    "@nestjs/platform-express": "catalog:backend",
    "@prisma/adapter-better-sqlite3": "catalog:backend",
    "@prisma/client": "catalog:backend",
    "{{apiPackageName}}": "workspace:*",
    "better-sqlite3": "catalog:backend",
    "dotenv": "catalog:backend",
    "dotenv-expand": "catalog:backend",
    "reflect-metadata": "catalog:backend",
    "rxjs": "catalog:backend",
    "source-map-support": "catalog:backend",
    "tstl": "catalog:backend",
    "typia": "catalog:samchon"
  },
  "devDependencies": {
    "@nestia/e2e": "catalog:samchon",
    "@nestia/sdk": "catalog:samchon",
    "@ttsc/lint": "catalog:typescript",
    "@types/express": "catalog:backend",
    "@types/node": "catalog:utils",
    "@types/swagger-ui-express": "catalog:backend",
    "express": "catalog:backend",
    "nestia": "catalog:samchon",
    "prisma": "catalog:backend",
    "prisma-markdown": "catalog:backend",
    "rimraf": "catalog:utils",
    "swagger-ui-express": "catalog:backend",
    "ttsc": "catalog:typescript",
    "typescript": "catalog:typescript"
  }
}
