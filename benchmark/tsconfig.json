{
  "extends": "../config/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": false,
    "noEmit": true,
    "plugins": [
      {
        "transform": "typia/lib/transform"
      }
    ],
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
