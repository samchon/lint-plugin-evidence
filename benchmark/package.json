{
  "private": true,
  "name": "@samchon/evidence-benchmark",
  "version": "0.4.4",
  "description": "Minimal Codex runner for the Evidence benchmark.",
  "type": "module",
  "exports": {
    "./runner": "./src/EvidenceBenchmarkRunner.ts",
    "./workspace": "./src/EvidenceBenchmarkWorkspace.ts"
  },
  "scripts": {
    "start": "ttsx --project tsconfig.json src/executable/EvidenceBenchmarkCommandLine.ts",
    "supervise": "ttsx --project tsconfig.json src/executable/EvidenceBenchmarkSupervision.ts",
    "dashboard": "ttsx --project tsconfig.json src/executable/EvidenceBenchmarkDashboard.ts",
    "report": "ttsx --project tsconfig.json src/executable/EvidenceBenchmarkReport.ts",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "catalog:utils",
    "ttsc": "catalog:typescript",
    "typia": "catalog:samchon",
    "typescript": "catalog:typescript"
  }
}
