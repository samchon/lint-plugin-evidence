{
  "private": true,
  "name": "@samchon/evidence-benchmark",
  "version": "0.0.0",
  "description": "Deterministic materialization and package preparation for the evidence benchmark.",
  "type": "module",
  "scripts": {
    "check": "pnpm run check:source && tsc --noEmit -p tsconfig.json",
    "check:source": "node --experimental-transform-types src/executable/check-source-contract.ts",
    "test": "pnpm run test:unit && pnpm run test:package",
    "test:baseline": "node --experimental-transform-types src/executable/self-test.ts --baseline",
    "test:quality": "node --experimental-transform-types src/executable/quality-self-test.ts",
    "test:unit": "node --experimental-transform-types src/executable/self-test.ts",
    "test:package": "node --experimental-transform-types src/executable/self-test.ts --package"
  },
  "devDependencies": {
    "@types/node": "catalog:utils",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "tar": "7.5.22",
    "typescript": "catalog:typescript",
    "typescript-api": "npm:typescript@5.9.3"
  }
}
