# Local knowledge base — see .agents/skills/wiki/SKILL.md. Deliberately not a
# repository artifact: it is working knowledge for whoever builds here next,
# not documentation for whoever consumes the package.
.wiki/

# Dependencies and package manager state
node_modules/

# Build outputs
/packages/evidence/lib/
dist/
coverage/
/packages/evidence/README.md
/packages/evidence/LICENSE

# Local caches and package archives — includes tests/*/.cache/ttsc, the shared
# plugin build cache the e2e harness pins so fixtures stop paying a cold Go link
# each.
.cache/
*.tgz
*.tsbuildinfo
*.log

# Canonical benchmark results are append-only evidence, not disposable local
# output. Preserve raw runner/gate logs and the evidence workspace's relative
# package archive so a committed demo never contains a broken file dependency.
!/benchmark/result/**/*.log
!/benchmark/result/**/*.tgz

# AI assistant data
.claude/

# Benchmark transient run state. Terminal runs are promoted into the tracked
# benchmark/result/<subject>/<arm> tree so the latest generated applications
# remain available as demo sources.
/benchmark/.work/

# Local Go workspace overlays
go.work
go.work.sum

# Stray native binaries from a bare `go build`
/plugin
